			html: "<blockquote><p>Capture a reviewer quote or customer-facing message here.</p></blockquote>"
		},
		code: {
			label: "Code sample",
			html: "<pre><code>fetch('/api/documents')\n  .then((response) =&gt; response.json())\n  .then((data) =&gt; console.log(data));</code></pre>"
		},
		table: {
			label: "Spec table",
			html: "<table><tr><th>Field</th><th>Status</th></tr><tr><td>Document API</td><td>Ready</td></tr><tr><td>Review workflow</td><td>Needs QA</td></tr></table><p></p>"
		}
	};
	var markdownLabTemplates = {
		release: "# Release notes\n\n## Highlights\n\n- Shipped threaded comments and review suggestions\n- Added AI-assisted rewrite and proofread actions\n- Improved the local playground for faster prototyping\n\n## Rollout notes\n\n> Turn on the feature flag after QA signs off.\n",
		meeting: "# Weekly product review\n\n## Decisions\n\n- Keep AI output suggestion-first\n- Focus next on richer command-style authoring tools\n\n## Follow-ups\n\n- Validate multi-user edit flows\n- Prepare a launch checklist\n",
		api: "# API changelog\n\n| Endpoint | Status | Notes |\n| --- | --- | --- |\n| `POST /api/documents` | Stable | Stores structured JSON documents |\n| `POST /api/documents/{id}/ai/suggestions` | Alpha | Creates reviewable AI suggestions |\n| `GET /api/documents/{id}/revisions` | Stable | Lists saved revisions |\n"
	};

	document.getElementById("clientDisplayName").value = "Editor " + clientSessionId.substring(0, 6);
	document.getElementById("commentStatusFilter").addEventListener("change", function () {
		renderCommentThreads(latestCommentThreads);
		scheduleEditorHighlightRefresh();
	});
	document.getElementById("commentCurrentSectionOnly").addEventListener("change", function () {
		renderCommentThreads(latestCommentThreads);
		scheduleEditorHighlightRefresh();
	});
	document.getElementById("suggestionStatusFilter").addEventListener("change", function () {
		renderSuggestions(latestSuggestions);
		scheduleEditorHighlightRefresh();
	});
	document.getElementById("suggestionTypeFilter").addEventListener("change", function () {
		renderSuggestions(latestSuggestions);
		scheduleEditorHighlightRefresh();
	});
	document.getElementById("suggestionCurrentSectionOnly").addEventListener("change", function () {
		renderSuggestions(latestSuggestions);
		scheduleEditorHighlightRefresh();
	});
	document.getElementById("aiModeInput").addEventListener("change", function () {
		toggleAiSettingsFields();
	});
	document.getElementById("markdownEditorInput").addEventListener("input", function () {
		updateMarkdownLabPreview();
	});
	document.addEventListener("keydown", function (event) {
		var key = String(event.key || "").toLowerCase();
		if ((event.ctrlKey || event.metaKey) && key === "k") {
			event.preventDefault();
			if (commandPaletteState.isOpen) {
				closeCommandPalette();
			}
			else {
				openCommandPalette();
			}
			return;
		}

		if ((event.ctrlKey || event.metaKey) && key === "f") {
			event.preventDefault();
			focusField("findQueryInput");
			return;
		}

		if (event.altKey && event.shiftKey && !event.ctrlKey && !event.metaKey && key === "j") {
			event.preventDefault();
			jumpReviewQueue(-1);
			return;
		}

		if (event.altKey && event.shiftKey && !event.ctrlKey && !event.metaKey && key === "k") {
			event.preventDefault();
			jumpReviewQueue(1);
			return;
		}

		if (event.altKey && event.shiftKey && !event.ctrlKey && !event.metaKey && key === "a") {
			var acceptTarget = getCurrentReviewQueueItem();
			if (acceptTarget && acceptTarget.kind === "suggestion") {
				event.preventDefault();
				runReviewQueueItemAction(acceptTarget, "accept");
				return;
			}
		}

		if (event.altKey && event.shiftKey && !event.ctrlKey && !event.metaKey && key === "r") {
			var reviewTarget = getCurrentReviewQueueItem();
			if (reviewTarget) {
				event.preventDefault();
				runReviewQueueItemAction(reviewTarget, reviewTarget.kind === "suggestion" ? "reject" : "resolve");
				return;
			}
		}

		if (commandPaletteState.isOpen && key === "escape") {
			event.preventDefault();
			closeCommandPalette();
		}
	});
	window.addEventListener("beforeunload", function (event) {
		if (!hasUnsavedChanges) {
			return;
		}

		persistAutosavedDraftNow("before-unload");
		event.preventDefault();
		event.returnValue = "";
	});
	applyEditorDocument(sampleDocument, false);
	editor1.attachEvent("change", function () {
		if (suppressEditorChange) {
			return;
		}

		hasUnsavedChanges = true;
		refreshEditorState();
		scheduleCommentAnchorRefresh();
		scheduleEditorHighlightRefresh();
		scheduleRevisionCompareRefresh();
	});
	document.getElementById("clientDisplayName").addEventListener("change", function () {
		if (currentDocumentId) {
			connectToDocumentRoom(currentDocumentId, true);
		}
	});
	window.addEventListener("resize", scheduleEditorHighlightRefresh);
	window.addEventListener("scroll", scheduleEditorHighlightRefresh, true);
	window.addEventListener("resize", scheduleSelectionActionBarRefresh);
	window.addEventListener("scroll", scheduleSelectionActionBarRefresh, true);
	window.addEventListener("resize", scheduleSlashCommandMenuRefresh);
	window.addEventListener("scroll", scheduleSlashCommandMenuRefresh, true);
	window.addEventListener("resize", scheduleBlockToolsRefresh);
	window.addEventListener("scroll", scheduleBlockToolsRefresh, true);
	window.addEventListener("resize", scheduleOutlineRefresh);
	window.addEventListener("scroll", scheduleOutlineRefresh, true);
	window.addEventListener("resize", scheduleFindRefresh);
	window.addEventListener("scroll", scheduleFindRefresh, true);
	document.addEventListener("mousedown", function (event) {
		var bar = document.getElementById("selectionActionBar");
		if (!selectionActionBarState.visible || !bar) {
			bar = null;
		}

		if (bar && event.target && bar.contains(event.target)) {
			return;
		}

		if (bar) {
			hideSelectionActionBar();
		}

		var slashMenu = document.getElementById("slashCommandMenu");
		if (slashCommandState.isOpen && slashMenu && (!event.target || !slashMenu.contains(event.target))) {
			closeSlashCommandMenu();
		}

		var blockToolsBar = document.getElementById("blockToolsBar");
		if (blockToolsState.visible && blockToolsBar && (!event.target || !blockToolsBar.contains(event.target))) {
			hideBlockToolsBar();
		}
	});

	refreshEditorState();
	checkForRecoverableDraft();
	seedMarkdownLabFromEditor();
	loadAiSettings(false);
	refreshSidebar();
	setStatus("Document workspace ready.", "success");
	setCollaborationStatus("No active room", "");
	renderParticipants([]);

	function setStatus(message, tone) {
		var banner = document.getElementById("statusBanner");
		banner.textContent = message;
		banner.className = "status-banner" + (tone ? " " + tone : "");
	}

	function setCollaborationStatus(message, tone) {
		var element = document.getElementById("collaborationStatus");
		element.textContent = message;
		element.className = "connection-pill" + (tone ? " " + tone : "");
	}

	function getDraftStorage() {
		try {
			return window.localStorage || null;
		}
		catch (error) {
			return null;
		}
	}

	function formatDraftTimestamp(value) {
		if (!value) {
			return "recently";
		}

		try {
			return new Date(value).toLocaleString();
		}
		catch (error) {
			return value;
		}
	}

	function getDraftStorageKey(documentId) {
		var normalizedId = String(documentId || "").trim();
		return normalizedId ? "doc:" + normalizedId : "untitled";
	}

	function getCurrentDraftStorageKey() {
		return getDraftStorageKey(currentDocumentId);
	}

	function readDraftStore() {
		var storage = getDraftStorage();
		if (!storage) {
			return { version: 2, drafts: [] };
		}

		var raw = storage.getItem(DRAFT_AUTOSAVE_STORAGE_KEY);
		if (!raw) {
			return { version: 2, drafts: [] };
		}

		try {
			var parsed = JSON.parse(raw);
			if (parsed && parsed.version === 2 && Array.isArray(parsed.drafts)) {
				return parsed;
			}

			if (parsed && parsed.version === 1 && parsed.document) {
				parsed.draftKey = getDraftStorageKey(parsed.documentId);
				return { version: 2, drafts: [parsed] };
			}
		}
		catch (error) {
		}

		return { version: 2, drafts: [] };
	}

	function writeDraftStore(store) {
		var storage = getDraftStorage();
		if (!storage) {
			return false;
		}

		storage.setItem(DRAFT_AUTOSAVE_STORAGE_KEY, JSON.stringify({
			version: 2,
			drafts: Array.isArray(store && store.drafts) ? store.drafts : []
		}));
		return true;
	}

	function getAllAutosavedDrafts() {
		return readDraftStore().drafts
			.slice()
			.sort(function (left, right) {
				return new Date(right.updatedUtc || 0).getTime() - new Date(left.updatedUtc || 0).getTime();
			});
	}

	function buildAutosavedDraftSnapshot() {
		return {
			version: 1,
			draftKey: getCurrentDraftStorageKey(),
			documentId: currentDocumentId || "",
			title: document.getElementById("documentTitle").value || "",
			revision: currentRevision || 0,
			updatedUtc: new Date().toISOString(),
			document: editor1.getJSON()
		};
	}

	function getAutosavedDraftFingerprint(snapshot) {
		if (!snapshot || !snapshot.document) {
			return "";
		}

		return JSON.stringify({
			documentId: snapshot.documentId || "",
			title: snapshot.title || "",
			revision: snapshot.revision || 0,
			document: snapshot.document
		});
	}

	function updateDraftAutosaveSummary(message, tone) {
		var element = document.getElementById("draftAutosaveSummary");
		if (!element) {
			return;
		}

		element.textContent = message;
		element.style.color = tone === "error"
			? "#b42318"
			: (tone === "success" ? "#067647" : "#475467");
	}

	function showDraftRecoveryBanner(snapshot) {
		var banner = document.getElementById("draftRecoveryBanner");
		var summary = document.getElementById("draftRecoverySummary");
		if (!banner || !summary || !snapshot) {
			return;
		}

		pendingDraftRecovery = snapshot;
		summary.textContent = "A local draft from " + formatDraftTimestamp(snapshot.updatedUtc)
			+ (snapshot.documentId ? " for document " + snapshot.documentId : " for an unsaved workspace")
			+ " is ready to restore.";
		banner.style.display = "block";
		renderLocalDraftList();
	}

	function hideDraftRecoveryBanner() {
		var banner = document.getElementById("draftRecoveryBanner");
		if (banner) {
			banner.style.display = "none";
		}
		pendingDraftRecovery = null;
		renderLocalDraftList();
	}

	function clearAutosavedDraft(options) {
		var targetKey = options && options.draftKey
			? options.draftKey
			: (lastDraftStorageKey || getCurrentDraftStorageKey());

		try {
			var store = readDraftStore();
			store.drafts = store.drafts.filter(function (draft) {
				return (draft.draftKey || getDraftStorageKey(draft.documentId)) !== targetKey;
			});
			writeDraftStore(store);
		}
		catch (error) {
		}

		if (lastDraftStorageKey === targetKey) {
			lastDraftStorageKey = "";
			lastDraftFingerprint = "";
		}

		if (pendingDraftRecovery && (pendingDraftRecovery.draftKey || getDraftStorageKey(pendingDraftRecovery.documentId)) === targetKey) {
			hideDraftRecoveryBanner();
		}

		renderLocalDraftList();
		if (!options || options.silent !== true) {
			updateDraftAutosaveSummary("Local autosave is clear.", "success");
		}
	}

	function persistAutosavedDraftNow(reason) {
		if (!hasUnsavedChanges) {
			return;
		}

		var storage = getDraftStorage();
		if (!storage) {
			updateDraftAutosaveSummary("Local autosave is unavailable in this browser.", "error");
			return;
		}

		try {
			var snapshot = buildAutosavedDraftSnapshot();
			var fingerprint = getAutosavedDraftFingerprint(snapshot);
			if (fingerprint && fingerprint === lastDraftFingerprint && reason !== "before-unload") {
				updateDraftAutosaveSummary("Local autosave is current.", "success");
				return;
			}

			var store = readDraftStore();
			store.drafts = store.drafts.filter(function (draft) {
				return (draft.draftKey || getDraftStorageKey(draft.documentId)) !== snapshot.draftKey;
			});
			store.drafts.push(snapshot);
			writeDraftStore(store);
			lastDraftStorageKey = snapshot.draftKey;
			lastDraftFingerprint = fingerprint;
			renderLocalDraftList();
			updateDraftAutosaveSummary("Autosaved locally at " + formatDraftTimestamp(snapshot.updatedUtc) + ".", "success");
		}
		catch (error) {
			updateDraftAutosaveSummary(error.message || "Unable to autosave this draft locally.", "error");
		}
	}

	function scheduleDraftAutosave() {
		if (!hasUnsavedChanges) {
			updateDraftAutosaveSummary(currentDocumentId
				? "All changes are synced with the saved document."
				: "Local autosave is ready.");
			return;
		}

		updateDraftAutosaveSummary("Autosaving your local draft...");
		if (draftAutosaveTimer) {
			window.clearTimeout(draftAutosaveTimer);
		}

		draftAutosaveTimer = window.setTimeout(function () {
			draftAutosaveTimer = 0;
			persistAutosavedDraftNow("timer");
		}, 900);
	}

	function checkForRecoverableDraft() {
		if (!getDraftStorage()) {
			updateDraftAutosaveSummary("Local autosave is unavailable in this browser.", "error");
			return;
		}

		try {
			var drafts = getAllAutosavedDrafts();
			renderLocalDraftList();
			if (!drafts.length) {
				updateDraftAutosaveSummary("Local autosave is ready.");
				return;
			}

			var currentKey = getCurrentDraftStorageKey();
			var snapshot = drafts.find(function (draft) {
				return (draft.draftKey || getDraftStorageKey(draft.documentId)) === currentKey;
			}) || drafts[0];
			showDraftRecoveryBanner(snapshot);
			updateDraftAutosaveSummary("A recoverable local draft is waiting for you.");
		}
		catch (error) {
			updateDraftAutosaveSummary("Unable to read the local autosave state.", "error");
		}
	}

	function restoreAutosavedDraft(draftKey) {
		var snapshot = draftKey
			? getAllAutosavedDrafts().find(function (draft) {
				return (draft.draftKey || getDraftStorageKey(draft.documentId)) === draftKey;
			})
			: pendingDraftRecovery;
		if (!snapshot || !snapshot.document) {
			hideDraftRecoveryBanner();
			updateDraftAutosaveSummary("Local autosave is ready.");
			return;
		}

		document.getElementById("documentId").value = snapshot.documentId || "";
		document.getElementById("documentTitle").value = snapshot.title || "Team notes";
		currentDocumentId = snapshot.documentId || "";
		currentRevision = snapshot.revision || 0;
		applyEditorDocument(snapshot.document, true);
		lastDraftStorageKey = snapshot.draftKey || getDraftStorageKey(snapshot.documentId);
		lastDraftFingerprint = getAutosavedDraftFingerprint(snapshot);
		renderDocumentMeta({
			id: snapshot.documentId || "",
			title: snapshot.title || "",
			revision: snapshot.revision || 0,
			currentRevisionId: null,
			createdUtc: null,
			updatedUtc: snapshot.updatedUtc || null
		});
		if (currentDocumentId) {
			connectToDocumentRoom(currentDocumentId, false);
		}
		hideDraftRecoveryBanner();
		setStatus("Restored the autosaved local draft.", "success");
		updateDraftAutosaveSummary("Recovered the local draft from " + formatDraftTimestamp(snapshot.updatedUtc) + ".", "success");
	}

	function discardAutosavedDraft(draftKey) {
		clearAutosavedDraft({
			silent: true,
			draftKey: draftKey || (pendingDraftRecovery ? pendingDraftRecovery.draftKey : "")
		});
		updateDraftAutosaveSummary("Discarded the recoverable local draft.", "success");
		setStatus("Discarded the local autosave snapshot.", "success");
	}

	function renderLocalDraftList() {
		var list = document.getElementById("localDraftList");
		if (!list) {
			return;
		}

		var drafts = [];
		try {
			drafts = getAllAutosavedDrafts();
		}
		catch (error) {
			list.innerHTML = "";
			var errorItem = document.createElement("li");
			errorItem.textContent = "Unable to read local drafts in this browser.";
			list.appendChild(errorItem);
			return;
		}

		list.innerHTML = "";
		if (!drafts.length) {
			var emptyItem = document.createElement("li");
			emptyItem.textContent = "No local drafts yet.";
			list.appendChild(emptyItem);
			return;
		}

		var currentKey = getCurrentDraftStorageKey();
		drafts.forEach(function (draft) {
			var draftKey = draft.draftKey || getDraftStorageKey(draft.documentId);
			var item = document.createElement("li");
			item.className = "local-draft-card";

			var title = document.createElement("div");
			title.className = "local-draft-title";
			title.textContent = draft.title || (draft.documentId ? "Untitled saved draft" : "Unsaved workspace draft");

			var meta = document.createElement("div");
			meta.className = "local-draft-meta";
			meta.textContent = (draft.documentId ? "Document " + draft.documentId : "Unsaved workspace")
				+ " | revision " + (draft.revision || 0)
				+ " | updated " + formatDraftTimestamp(draft.updatedUtc)
				+ (draftKey === currentKey ? " | current context" : "");

			var actions = document.createElement("div");
			actions.className = "local-draft-actions";

			var restoreButton = document.createElement("button");
			restoreButton.type = "button";
			restoreButton.className = "thread-action primary";
			restoreButton.textContent = "Restore";
			restoreButton.onclick = function () {
				restoreAutosavedDraft(draftKey);
			};

			var discardButton = document.createElement("button");
			discardButton.type = "button";
			discardButton.className = "thread-action";
			discardButton.textContent = "Discard";
			discardButton.onclick = function () {
				discardAutosavedDraft(draftKey);
			};

			actions.appendChild(restoreButton);
			actions.appendChild(discardButton);
			item.appendChild(title);
			item.appendChild(meta);
			item.appendChild(actions);
			list.appendChild(item);
		});
	}

	function applyEditorDocument(documentModel, markDirty) {
		suppressEditorChange = true;
		editor1.setJSON(documentModel);
		suppressEditorChange = false;
		pendingRemoteDocument = null;
		togglePendingRemoteUpdate(false);
		clearConflictState();
		hasUnsavedChanges = !!markDirty;
		refreshEditorState();
		scheduleCommentAnchorRefresh();
		scheduleEditorHighlightRefresh();
		scheduleRevisionCompareRefresh();
		scheduleDraftAutosave();
	}

	function loadSample() {
		if (hasUnsavedChanges) {
			persistAutosavedDraftNow("before-switch");
		}

		currentDocumentId = "";
		currentRevision = 0;
		document.getElementById("documentId").value = "";
		document.getElementById("documentMeta").textContent = "";
		disconnectFromDocumentRoom();
		activeLocatedThreadId = "";
		activeLocatedSuggestionId = "";
		activeReviewQueueKey = "";
		replyDrafts = {};
		latestCommentThreads = [];
		latestSuggestions = [];
		latestRevisionSummaries = [];
		clearEditorHighlights();
		applyEditorDocument(sampleDocument, false);
		clearCommentComposer();
		clearSuggestionComposer();
		clearRevisionCompare();
		refreshSidebar();
		setStatus("Loaded the sample structured document.", "success");
	}

	async function loadAiSettings(showStatus) {
		try {
			var response = await fetch("/api/ai/settings");
			if (!response.ok) {
				throw new Error(await readError(response, "Unable to load AI settings."));
			}

			renderAiSettings(await response.json());
			if (showStatus) {
				setStatus("Loaded AI settings.", "success");
			}
		}
		catch (error) {
			document.getElementById("aiSettingsSummary").textContent = error.message || "Unable to load AI settings.";
			document.getElementById("aiRunSummary").textContent = "AI settings are unavailable until the backend responds.";
			if (showStatus) {
				setStatus(error.message || "Unable to load AI settings.", "error");
			}
		}
	}

	function renderAiSettings(settings) {
		aiSettingsState = settings || {};
		document.getElementById("aiModeInput").value = aiSettingsState.mode || "demo";
		document.getElementById("aiApiBaseUrlInput").value = aiSettingsState.apiBaseUrl || "";
		document.getElementById("aiModelInput").value = aiSettingsState.model || "";
		document.getElementById("aiSystemPromptInput").value = aiSettingsState.systemPrompt || "";
		document.getElementById("aiTemperatureInput").value = typeof aiSettingsState.temperature === "number"
			? aiSettingsState.temperature
			: 0.2;
		document.getElementById("aiApiKeyInput").value = "";
		document.getElementById("aiApiKeyInput").placeholder = aiSettingsState.apiKeyConfigured
			? "Stored key is configured. Leave blank to keep it."
			: "Paste an admin API key to enable provider calls";
		toggleAiSettingsFields();
	}

	function toggleAiSettingsFields() {
		var mode = document.getElementById("aiModeInput").value;
		var isDemoMode = mode !== "openai-compatible";
		document.getElementById("aiApiBaseUrlGroup").style.display = isDemoMode ? "none" : "";
		document.getElementById("aiApiKeyGroup").style.display = isDemoMode ? "none" : "";
		document.getElementById("aiSettingsSummary").textContent = isDemoMode
			? "Demo mode is active. No external provider or API key is required for local testing."
			: (aiSettingsState && aiSettingsState.apiKeyConfigured
				? "OpenAI-compatible mode is active. A stored admin API key is configured on the server."
				: "OpenAI-compatible mode is active. Add an admin API key to enable real provider calls.");
	}

	async function saveAiSettings() {
		try {
			var response = await fetch("/api/ai/settings", {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					mode: document.getElementById("aiModeInput").value,
					apiBaseUrl: document.getElementById("aiApiBaseUrlInput").value,
					model: document.getElementById("aiModelInput").value,
					apiKey: document.getElementById("aiApiKeyInput").value,
					systemPrompt: document.getElementById("aiSystemPromptInput").value,
					temperature: parseFloat(document.getElementById("aiTemperatureInput").value),
					preserveExistingApiKey: true
				})
			});

			if (!response.ok) {
				throw new Error(await readError(response, "Unable to save AI settings."));
			}

			renderAiSettings(await response.json());
			document.getElementById("aiRunSummary").textContent = document.getElementById("aiModeInput").value === "openai-compatible"
				? "AI settings saved. Run AI on a captured selection to create a provider-backed suggestion."
				: "AI settings saved. Demo mode is ready for local testing.";
			setStatus("Saved AI settings.", "success");
		}
		catch (error) {
			setStatus(error.message || "Unable to save AI settings.", "error");
		}
	}

	function refreshEditorState() {
		ensureSelectionActionBarListeners();
		ensureSlashCommandListeners();
		ensureBlockToolsListeners();
		ensureOutlineListeners();
		ensureFindListeners();
		var documentModel = editor1.getJSON();
		var validation = RichTextEditor.validateStructuredContent(documentModel);
		document.getElementById("jsonPreview").value = JSON.stringify(documentModel, null, 2);
		document.getElementById("markdownPreview").value = getDocumentMarkdown(documentModel);
		document.getElementById("validationSummary").textContent = validation.valid
			? "Structured document is valid."
			: "Validation issues found. Fix them before saving.";
		document.getElementById("validationSummary").style.color = validation.valid ? "#067647" : "#b42318";
		document.getElementById("validationIssues").value = validation.valid
			? "[]"
			: JSON.stringify(validation.issues, null, 2);
		renderStructureExplorer(documentModel);
		renderDocumentOutline(documentModel);
		renderReviewQueue(documentModel);
		scheduleDraftAutosave();
		scheduleSelectionActionBarRefresh();
		scheduleSlashCommandMenuRefresh();
		scheduleBlockToolsRefresh();
		scheduleOutlineRefresh();
		scheduleFindRefresh();
	}

	function getPayloadOrThrow(forceSave) {
		var documentModel = editor1.getJSON();
		var validation = RichTextEditor.validateStructuredContent(documentModel);
		refreshEditorState();
		if (!validation.valid) {
			setStatus("Validation issues must be resolved before save.", "error");
			throw new Error("validation");
		}

		return {
			title: document.getElementById("documentTitle").value,
			clientSessionId: clientSessionId,
			clientDisplayName: getClientDisplayName(),
			expectedRevision: currentRevision > 0 ? currentRevision : null,
			forceSave: !!forceSave,
			document: documentModel
		};
	}

	async function createDocument() {
		try {
			var response = await fetch("/api/documents", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(getPayloadOrThrow(false))
			});

			await handleDocumentResponse(response, "Created document");
		}
		catch (error) {
			if (error.message !== "validation") {
				setStatus(error.message || "Create failed.", "error");
			}
		}
	}

	async function saveDocument(forceSave) {
		var documentId = document.getElementById("documentId").value.trim();
		if (!documentId) {
			setStatus("Create or load a document before saving.", "error");
			return;
		}

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(documentId), {
				method: "PUT",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify(getPayloadOrThrow(!!forceSave))
			});

			if (response.status === 409) {
				await handleConflictResponse(response);
				return;
			}

			await handleDocumentResponse(response, forceSave ? "Force-saved document" : "Saved document");
		}
		catch (error) {
			if (error.message !== "validation") {
				setStatus(error.message || "Save failed.", "error");
			}
		}
	}

	async function loadDocument(idOverride) {
		var documentId = idOverride || document.getElementById("documentId").value.trim();
		if (!documentId) {
			setStatus("Enter a document id to load.", "error");
			return;
		}

		if (hasUnsavedChanges) {
			persistAutosavedDraftNow("before-switch");
		}

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(documentId));
			if (!response.ok) {
				throw new Error(await readError(response, "Load failed."));
			}

			var result = await response.json();
			applyDocumentResponse(result);
			setStatus("Loaded document " + result.id + ".", "success");
		}
		catch (error) {
			setStatus(error.message || "Load failed.", "error");
		}
	}

	async function handleDocumentResponse(response, successPrefix) {
		if (!response.ok) {
			throw new Error(await readError(response, successPrefix + " failed."));
		}

		var result = await response.json();
		applyDocumentResponse(result);
		clearAutosavedDraft({ silent: true });
		updateDraftAutosaveSummary("All changes are synced with the saved document.", "success");
		setStatus(successPrefix + " " + result.id + ".", "success");
	}

	async function handleConflictResponse(response) {
		var conflict = await response.json();
		pendingConflictDocument = conflict.currentDocument || null;
		renderConflictState(conflict);
		setStatus(conflict.message || "The server already has a newer revision.", "error");
	}

	function applyDocumentResponse(result) {
		var isDifferentDocument = currentDocumentId !== (result.id || "");
		if (isDifferentDocument) {
			replyDrafts = {};
			activeLocatedThreadId = "";
			activeLocatedSuggestionId = "";
			latestCommentThreads = [];
			latestSuggestions = [];
			latestRevisionSummaries = [];
			clearCommentComposer();
			clearSuggestionComposer();
		}

		document.getElementById("documentId").value = result.id || "";
		document.getElementById("documentTitle").value = result.title || "";
		currentDocumentId = result.id || "";
		currentRevision = result.revision || 0;
		applyEditorDocument(result.document, false);
		renderDocumentMeta(result);
		clearRevisionCompare();
		refreshSidebar();
		connectToDocumentRoom(currentDocumentId, false);
	}

	function renderDocumentMeta(result) {
		document.getElementById("documentMeta").textContent = JSON.stringify({
			id: result.id,
			title: result.title,
			revision: result.revision,
			currentRevisionId: result.currentRevisionId,
			createdUtc: result.createdUtc,
			updatedUtc: result.updatedUtc
		}, null, 2);
	}

	function clearRevisionCompare() {
		activeComparedRevisionId = "";
		latestComparedRevisionSnapshot = null;
		var compareButton = document.getElementById("compareLatestRevisionButton");
		var clearButton = document.getElementById("clearRevisionCompareButton");
		var summary = document.getElementById("revisionCompareSummary");
		var details = document.getElementById("revisionCompareDetails");
		if (compareButton) {
			compareButton.disabled = !latestRevisionSummaries.length || !currentDocumentId;
		}

		if (clearButton) {
			clearButton.disabled = true;
		}

		if (summary) {
			summary.textContent = currentDocumentId
				? "Choose a saved revision to compare against the current draft."
				: "Load a saved document to compare a stored revision with the current draft.";
		}

		if (details) {
			details.innerHTML = "";
		}

		if (latestRevisionSummaries.length) {
			renderRevisions(latestRevisionSummaries);
		}
	}

	function renderConflictState(conflict) {
		var conflictBox = document.getElementById("conflictBox");
		var conflictActions = document.getElementById("conflictActions");
		var actualRevision = conflict.actualRevision || (conflict.currentDocument && conflict.currentDocument.revision) || 0;
		var expectedRevision = conflict.expectedRevision || currentRevision || 0;
		conflictBox.textContent = "Save conflict: your editor was based on revision "
			+ expectedRevision
			+ ", but the server is already at revision "
			+ actualRevision
			+ ". Load the latest revision or force save to overwrite it.";
		conflictBox.style.display = "block";
		conflictActions.style.display = "flex";
	}

	function clearConflictState() {
		pendingConflictDocument = null;
		document.getElementById("conflictBox").style.display = "none";
		document.getElementById("conflictBox").textContent = "";
		document.getElementById("conflictActions").style.display = "none";
	}

	function loadConflictDocument() {
		if (!pendingConflictDocument) {
			return;
		}

		applyDocumentResponse(pendingConflictDocument);
		setStatus("Loaded the latest server revision after a save conflict.", "success");
	}

	function clearCommentComposer() {
		currentCommentAnchor = null;
		document.getElementById("commentAnchorInput").value = "";
		document.getElementById("commentBodyInput").value = "";
		setCurrentCommentSuggestionLink("");
		renderCapturedAnchor(null);
	}

	function clearSuggestionComposer() {
		currentSuggestionAnchor = null;
		document.getElementById("suggestionAnchorInput").value = "";
		document.getElementById("suggestionBodyInput").value = "";
		document.getElementById("suggestedTextInput").value = "";
		document.getElementById("suggestionTypeInput").value = "delete";
		renderSuggestionAnchor(null);
	}

	function renderCapturedAnchor(anchor) {
		renderAnchorMeta(anchor, "commentAnchorMeta");
	}

	function renderSuggestionAnchor(anchor) {
		renderAnchorMeta(anchor, "suggestionAnchorMeta");
	}

	function findSuggestionById(suggestionId) {
		if (!suggestionId) {
			return null;
		}

		for (var index = 0; index < latestSuggestions.length; index += 1) {
			if (latestSuggestions[index].suggestionId === suggestionId) {
				return latestSuggestions[index];
			}
		}

