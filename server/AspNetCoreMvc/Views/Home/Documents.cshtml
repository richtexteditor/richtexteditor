	function useSelectionForFind() {
		var selectedText = getSelectedAnchorText();
		if (!selectedText) {
			setStatus("Select text inside the editor first, then reuse it as a find query.", "error");
			return;
		}

		var input = document.getElementById("findQueryInput");
		if (!input) {
			return;
		}

		input.value = selectedText;
		renderFindResults(false);
		setStatus("Loaded the current selection into the find panel.", "success");
	}

	function locateFindMatch(index) {
		if (!findState.matches.length) {
			setStatus("Type a search query before jumping to matches.", "error");
			return;
		}

		var safeIndex = Math.max(0, Math.min(index, findState.matches.length - 1));
		var match = findState.matches[safeIndex];
		var editorIndex = buildEditorDomTextIndex();
		if (!editorIndex) {
			setStatus("The editor document is not ready for search navigation yet.", "error");
			return;
		}

		var range = createEditorRangeFromOffsets(editorIndex, match.startOffset, match.endOffset);
		if (!range) {
			setStatus("That search match could not be located in the current editor view.", "error");
			return;
		}

		editor1.focus();
		var selection = editorIndex.document.defaultView && editorIndex.document.defaultView.getSelection
			? editorIndex.document.defaultView.getSelection()
			: null;
		if (selection) {
			selection.removeAllRanges();
			selection.addRange(range);
		}

		var targetElement = range.startContainer && range.startContainer.parentElement
			? range.startContainer.parentElement
			: editorIndex.document.body;
		if (targetElement && targetElement.scrollIntoView) {
			targetElement.scrollIntoView({ block: "center", behavior: "smooth" });
		}

		findState.activeIndex = safeIndex;
		renderFindResults(true);
		setStatus("Jumped to search match " + (safeIndex + 1) + " of " + findState.matches.length + ".", "success");
	}

	function stepFindMatch(delta) {
		if (!findState.matches.length) {
			setStatus("Type a search query before stepping through matches.", "error");
			return;
		}

		var nextIndex = findState.activeIndex < 0
			? 0
			: (findState.activeIndex + delta + findState.matches.length) % findState.matches.length;
		locateFindMatch(nextIndex);
	}

	function applyFindMatchReplacement(match, replacementText, options) {
		if (!match) {
			return false;
		}

		var settings = options || {};
		var editorIndex = buildEditorDomTextIndex();
		if (!editorIndex) {
			if (!settings.silent) {
				setStatus("The editor document is not ready for replacement yet.", "error");
			}
			return false;
		}

		var range = createEditorRangeFromOffsets(editorIndex, match.startOffset, match.endOffset);
		if (!range) {
			if (!settings.silent) {
				setStatus("That search match could not be located in the current editor view.", "error");
			}
			return false;
		}

		editor1.focus();
		var selection = editorIndex.document.defaultView && editorIndex.document.defaultView.getSelection
			? editorIndex.document.defaultView.getSelection()
			: null;
		if (selection) {
			selection.removeAllRanges();
			selection.addRange(range);
		}

		try {
			if (replacementText) {
				editor1.insertText(replacementText);
			}
			else if (typeof editor1["delete"] === "function") {
				editor1["delete"]();
			}
			else {
				editor1.insertText("");
			}
		}
		catch (error) {
			if (!settings.silent) {
				setStatus(error.message || "Replacing this match failed.", "error");
			}
			return false;
		}

		if (typeof editor1.notifySelectionChange === "function") {
			editor1.notifySelectionChange();
		}

		hasUnsavedChanges = true;
		if (!settings.skipRefresh) {
			refreshEditorState();
			renderFindResults(false);
		}

		return true;
	}

	function replaceCurrentFindMatch() {
		if (!findState.matches.length) {
			setStatus("Type a search query before replacing matches.", "error");
			return;
		}

		var replaceInput = document.getElementById("findReplaceInput");
		var replacementText = replaceInput ? String(replaceInput.value || "") : "";
		var activeIndex = findState.activeIndex >= 0 ? findState.activeIndex : 0;
		if (!applyFindMatchReplacement(findState.matches[activeIndex], replacementText, { skipRefresh: true })) {
			return;
		}

		refreshEditorState();
		renderFindResults(false);
		setStatus("Replaced search match " + (activeIndex + 1) + ".", "success");
	}

	function replaceAllFindMatches() {
		if (!findState.matches.length) {
			setStatus("Type a search query before replacing matches.", "error");
			return;
		}

		var replaceInput = document.getElementById("findReplaceInput");
		var replacementText = replaceInput ? String(replaceInput.value || "") : "";
		if (normalizePlainText(replacementText) === normalizePlainText(findState.query)) {
			setStatus("The replacement text matches the current query, so there is nothing to change.", "error");
			return;
		}

		var snapshotMatches = findState.matches.slice().sort(function (left, right) {
			return right.startOffset - left.startOffset;
		});
		var replacedCount = 0;
		snapshotMatches.forEach(function (match) {
			if (applyFindMatchReplacement(match, replacementText, { silent: true, skipRefresh: true })) {
				replacedCount += 1;
			}
		});

		if (!replacedCount) {
			setStatus("No matches could be replaced in the current draft.", "error");
			return;
		}

		refreshEditorState();
		renderFindResults(false);
		setStatus("Replaced " + replacedCount + " search match" + (replacedCount === 1 ? "" : "es") + ".", "success");
	}

	function renderStructureExplorer(documentModel) {
		var tree = document.getElementById("structureTree");
		if (!tree) {
			return;
		}

		var nodes = [];
		var counts = { total: 0, byType: {} };
		collectStructureExplorerNodes(documentModel, [], 0, nodes, counts);
		renderStructureSummary(counts);

		if (!nodes.length) {
			tree.innerHTML = "";
			renderStructureDetail(null);
			return;
		}

		if (!nodes.some(function (entry) { return entry.pathKey === selectedStructureNodePathKey; })) {
			selectedStructureNodePathKey = "root";
		}

		tree.innerHTML = "";
		nodes.forEach(function (entry) {
			var item = document.createElement("li");
			item.className = "structure-tree-item";

			var button = document.createElement("button");
			button.type = "button";
			button.className = "structure-node-button" + (entry.pathKey === selectedStructureNodePathKey ? " active" : "");
			button.style.paddingLeft = (10 + (entry.depth * 18)) + "px";
			button.onclick = function () {
				selectStructureNode(entry.pathKey);
			};

			var title = document.createElement("span");
			title.className = "structure-node-title";
			title.textContent = entry.label;

			var meta = document.createElement("span");
			meta.className = "structure-node-meta";
			meta.textContent = "Path " + entry.pathKey;

			var preview = document.createElement("span");
			preview.className = "structure-node-preview";
			preview.textContent = entry.preview;

			button.appendChild(title);
			button.appendChild(meta);
			button.appendChild(preview);
			item.appendChild(button);
			tree.appendChild(item);
		});

		renderStructureDetail(nodes.find(function (entry) {
			return entry.pathKey === selectedStructureNodePathKey;
		}) || nodes[0]);
	}

	function focusField(fieldId) {
		var element = document.getElementById(fieldId);
		if (!element || typeof element.focus !== "function") {
