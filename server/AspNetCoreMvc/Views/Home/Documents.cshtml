		structuredIndex.blocks.forEach(function (block) {
			if (preferredType && block.type !== preferredType) {
				return;
			}

			var matches = findAllOccurrences(block.text, anchorText);
			matches.forEach(function (relativeStartOffset) {
				var score = scoreStructuredAnchorCandidate(block, relativeStartOffset, anchorText.length, globalStartOffset, contextBefore, contextAfter);
				var candidate = {
					block: block,
					blockEndOffset: relativeStartOffset + anchorText.length,
					blockStartOffset: relativeStartOffset,
					score: score
				};

				if (!bestCandidate || candidate.score > bestCandidate.score) {
					bestCandidate = candidate;
				}
			});
		});

		return bestCandidate;
	}

	function findBestStructuredTextNode(structuredIndex, anchorText, globalStartOffset, contextBefore, contextAfter, preferredPathKey, preferredBlockPathKey) {
		if (!structuredIndex || !structuredIndex.textNodes || !structuredIndex.textNodes.length || !anchorText) {
