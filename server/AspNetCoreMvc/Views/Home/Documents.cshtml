	function stageSelectionActionSuggestionAnchor(options) {
		var settings = options || {};
		if (!selectionActionBarState.anchor || !selectionActionBarState.anchor.anchorText) {
			setStatus("Select text inside the editor first, then create a suggestion from that selection.", "error");
