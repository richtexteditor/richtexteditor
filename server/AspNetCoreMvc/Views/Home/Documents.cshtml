@{
	ViewData["Title"] = "Documents API";
}

<link rel="stylesheet" href="/richtexteditor/rte_theme_default.css" />
<script type="text/javascript" src="/richtexteditor/rte.js"></script>
<script type="text/javascript" src="/richtexteditor/plugins/all_plugins.js"></script>
<script type="text/javascript" src="/richtexteditor/structured-content-bridge.js"></script>
<script type="text/javascript" src="/rte-upload.js"></script>

<style>
	.document-grid {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(320px, 1fr);
		gap: 24px;
		align-items: start;
	}

	.panel-card {
		border: 1px solid #d6deea;
		border-radius: 16px;
		background: #fff;
		box-shadow: 0 12px 28px rgba(15, 44, 85, 0.08);
		padding: 18px;
	}

	.panel-card + .panel-card {
		margin-top: 16px;
	}

	.status-banner {
		border-radius: 12px;
		padding: 12px 14px;
		font-weight: 600;
		margin-bottom: 16px;
		background: #eef5ff;
		color: #124f9c;
	}

	.status-banner.error {
		background: #fff1f0;
		color: #b42318;
	}

	.status-banner.success {
		background: #ecfdf3;
		color: #067647;
	}

	.control-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 12px;
		margin-bottom: 16px;
	}

	.field-stack {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-bottom: 12px;
	}

	.control-grid label,
	.toolbar-row label,
	.field-stack label {
		display: block;
		font-size: 0.9rem;
		font-weight: 600;
		margin-bottom: 0;
	}

	.control-grid input,
	.toolbar-row input,
	.toolbar-row select,
	.field-stack input,
	.field-stack select,
	.field-stack textarea {
		width: 100%;
		padding: 10px 12px;
		border: 1px solid #c4cfdd;
		border-radius: 10px;
	}

	.field-stack textarea {
		resize: vertical;
		min-height: 92px;
	}

	.toolbar-row {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 16px;
	}

	.toolbar-row button,
	.secondary-button {
		border: 0;
		border-radius: 999px;
		padding: 10px 14px;
		font-weight: 600;
	}

	.toolbar-row button {
		background: #124f9c;
		color: #fff;
	}

	.toolbar-row button.secondary,
	.secondary-button {
		background: #e9eef6;
		color: #1d2939;
	}

	.preview-block {
		margin-top: 18px;
	}

	.preview-block h3,
	.panel-card h3 {
		font-size: 1rem;
		margin-bottom: 12px;
	}

	.preview-block textarea,
	.structure-detail textarea,
	.code-block {
		width: 100%;
		min-height: 200px;
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 12px;
		background: #f8fbff;
		font: 13px/1.5 Consolas, Monaco, monospace;
		white-space: pre-wrap;
	}

	.playground-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
		margin-top: 18px;
	}

	.snippet-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 10px;
	}

	.snippet-button {
		border: 1px solid #c9d6e6;
		border-radius: 14px;
		background: linear-gradient(180deg, #fdfefe 0%, #eef5ff 100%);
		padding: 12px;
		text-align: left;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
	}

	.snippet-button strong {
		display: block;
		font-size: 0.92rem;
		margin-bottom: 4px;
		color: #12396f;
	}

	.snippet-button span {
		display: block;
		font-size: 0.82rem;
		line-height: 1.45;
		color: #475467;
	}

	.structure-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 16px;
	}

	.structure-summary {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 12px;
	}

	.structure-pill {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		padding: 5px 10px;
		background: #eef5ff;
		color: #124f9c;
		font-size: 0.82rem;
		font-weight: 700;
	}

	.structure-tree {
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 10px;
		background: #fbfdff;
		max-height: 380px;
		overflow: auto;
	}

	.structure-tree-item + .structure-tree-item {
		margin-top: 6px;
	}

	.structure-node-button {
		width: 100%;
		border: 1px solid transparent;
		border-radius: 10px;
		background: transparent;
		padding: 8px 10px;
		text-align: left;
	}

	.structure-node-button.active {
		border-color: #124f9c;
		background: #eef5ff;
		box-shadow: 0 0 0 1px rgba(18, 79, 156, 0.12);
	}

	.structure-node-title {
		display: block;
		font-size: 0.88rem;
		font-weight: 700;
		color: #1d2939;
	}

	.structure-node-meta {
		display: block;
		font-size: 0.78rem;
		color: #667085;
		margin-top: 2px;
	}

	.structure-node-preview {
		display: block;
		font-size: 0.8rem;
		color: #475467;
		margin-top: 4px;
		line-height: 1.45;
	}

	.structure-detail {
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 12px;
		background: #f8fbff;
	}

	.structure-detail-title {
		font-size: 0.98rem;
		font-weight: 700;
		color: #12396f;
		margin-bottom: 6px;
	}

	.structure-detail-meta {
		font-size: 0.84rem;
		color: #475467;
		margin-bottom: 10px;
	}

	.structure-detail textarea {
		min-height: 240px;
	}

	.markdown-lab-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 16px;
	}

	.markdown-lab-preview {
		min-height: 260px;
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 14px;
		background: #fbfdff;
		overflow: auto;
	}

	.markdown-lab-preview h1,
	.markdown-lab-preview h2,
	.markdown-lab-preview h3 {
		margin-top: 0;
	}

	.markdown-lab-preview table {
		width: 100%;
		border-collapse: collapse;
	}

	.markdown-lab-preview th,
	.markdown-lab-preview td {
		border: 1px solid #d6deea;
		padding: 8px 10px;
	}

	.markdown-lab-preview code,
	.markdown-lab-preview pre {
		font-family: Consolas, Monaco, monospace;
	}

	.markdown-lab-preview pre {
		padding: 12px;
		border-radius: 10px;
		background: #101828;
		color: #f8fafc;
		overflow: auto;
	}

	.markdown-template-row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 12px;
	}

	.markdown-template-button {
		border: 1px solid #c9d6e6;
		border-radius: 999px;
		background: #eef5ff;
		color: #124f9c;
		padding: 7px 12px;
		font-size: 0.8rem;
		font-weight: 700;
	}

	.command-palette-overlay {
		position: fixed;
		inset: 0;
		display: none;
		align-items: flex-start;
		justify-content: center;
		padding: 72px 20px 24px;
		background: rgba(15, 23, 42, 0.48);
		backdrop-filter: blur(8px);
		z-index: 1200;
	}

	.command-palette-panel {
		width: min(760px, 100%);
		border: 1px solid rgba(214, 222, 234, 0.95);
		border-radius: 20px;
		background: rgba(255, 255, 255, 0.98);
		box-shadow: 0 24px 64px rgba(15, 23, 42, 0.28);
		padding: 18px;
	}

	.command-palette-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 12px;
	}

	.command-palette-title {
		font-size: 1rem;
		font-weight: 800;
		color: #12396f;
	}

	.command-palette-input {
		width: 100%;
		padding: 12px 14px;
		border: 1px solid #c4cfdd;
		border-radius: 14px;
		font-size: 0.96rem;
		margin-bottom: 12px;
	}

	.command-palette-list {
		max-height: 420px;
		overflow: auto;
	}

	.command-palette-item + .command-palette-item {
		margin-top: 8px;
	}

	.command-palette-button {
		width: 100%;
		border: 1px solid transparent;
		border-radius: 14px;
		background: #fbfdff;
		padding: 12px 14px;
		text-align: left;
	}

	.command-palette-button.active {
		border-color: #124f9c;
		background: #eef5ff;
		box-shadow: 0 0 0 1px rgba(18, 79, 156, 0.12);
	}

	.command-palette-button:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.command-palette-item-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.command-palette-item-label {
		font-size: 0.92rem;
		font-weight: 700;
		color: #1d2939;
	}

	.command-palette-item-shortcut {
		font-size: 0.76rem;
		font-weight: 700;
		color: #667085;
	}

	.command-palette-item-meta {
		display: block;
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #124f9c;
		margin-top: 4px;
	}

	.command-palette-item-description {
		display: block;
		font-size: 0.84rem;
		color: #475467;
		margin-top: 6px;
		line-height: 1.45;
	}

	.selection-action-bar {
		position: fixed;
		display: none;
		align-items: center;
		gap: 12px;
		max-width: min(460px, calc(100vw - 16px));
		padding: 10px 12px;
		border: 1px solid rgba(214, 222, 234, 0.95);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.98);
		box-shadow: 0 20px 44px rgba(15, 23, 42, 0.2);
		backdrop-filter: blur(8px);
		z-index: 1250;
	}

	.selection-action-meta {
		min-width: 0;
		flex: 1 1 auto;
	}

	.selection-action-label {
		font-size: 0.74rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #124f9c;
	}

	.selection-action-preview {
		margin-top: 2px;
		font-size: 0.84rem;
		line-height: 1.4;
		color: #1d2939;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.selection-action-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		justify-content: flex-end;
	}

	.selection-action-button {
		border: 0;
		border-radius: 999px;
		padding: 8px 12px;
		font-size: 0.76rem;
		font-weight: 700;
		background: #e9eef6;
		color: #1d2939;
		cursor: pointer;
	}

	.selection-action-button.primary {
		background: #124f9c;
		color: #fff;
	}

	.slash-command-menu {
		position: fixed;
		display: none;
		width: min(340px, calc(100vw - 16px));
		border: 1px solid rgba(214, 222, 234, 0.95);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.98);
		box-shadow: 0 20px 44px rgba(15, 23, 42, 0.22);
		backdrop-filter: blur(8px);
		z-index: 1240;
		padding: 12px;
	}

	.slash-command-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 10px;
	}

	.slash-command-title {
		font-size: 0.9rem;
		font-weight: 800;
		color: #12396f;
	}

	.slash-command-query {
		font-size: 0.76rem;
		font-weight: 700;
		color: #667085;
		margin-top: 3px;
	}

	.slash-command-list {
		max-height: 280px;
		overflow: auto;
	}

	.slash-command-item + .slash-command-item {
		margin-top: 8px;
	}

	.slash-command-button {
		width: 100%;
		border: 1px solid transparent;
		border-radius: 14px;
		background: #fbfdff;
		padding: 10px 12px;
		text-align: left;
	}

	.slash-command-button.active {
		border-color: #124f9c;
		background: #eef5ff;
		box-shadow: 0 0 0 1px rgba(18, 79, 156, 0.12);
	}

	.slash-command-label {
		font-size: 0.84rem;
		font-weight: 700;
		color: #1d2939;
	}

	.slash-command-description {
		display: block;
		font-size: 0.78rem;
		line-height: 1.45;
		color: #475467;
		margin-top: 4px;
	}

	.block-tools-bar {
		position: fixed;
		display: none;
		align-items: center;
		gap: 12px;
		max-width: min(560px, calc(100vw - 16px));
		padding: 10px 12px;
		border: 1px solid rgba(214, 222, 234, 0.95);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.98);
		box-shadow: 0 20px 44px rgba(15, 23, 42, 0.2);
		backdrop-filter: blur(8px);
		z-index: 1235;
	}

	.block-tools-meta {
		min-width: 0;
		flex: 1 1 auto;
	}

	.block-tools-title {
		font-size: 0.76rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #124f9c;
	}

	.block-tools-preview {
		margin-top: 2px;
		font-size: 0.84rem;
		line-height: 1.4;
		color: #1d2939;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.block-tools-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		justify-content: flex-end;
	}

	.block-tools-button {
		border: 0;
		border-radius: 999px;
		padding: 8px 12px;
		font-size: 0.76rem;
		font-weight: 700;
		background: #e9eef6;
		color: #1d2939;
		cursor: pointer;
	}

	.block-tools-button.primary {
		background: #124f9c;
		color: #fff;
	}

	.block-tools-button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.draft-recovery-banner {
		display: none;
		margin-bottom: 16px;
		border: 1px solid #d6deea;
		border-radius: 16px;
		background: #fffdf6;
		box-shadow: 0 10px 24px rgba(123, 92, 0, 0.08);
		padding: 16px 18px;
	}

	.draft-recovery-title {
		font-size: 1rem;
		font-weight: 800;
		color: #7a4e00;
		margin-bottom: 6px;
	}

	.draft-autosave-summary {
		margin-top: 12px;
		margin-bottom: 0;
	}

	.local-draft-card {
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 12px;
		background: #fbfdff;
	}

	.local-draft-title {
		font-weight: 700;
		color: #1d2939;
	}

	.local-draft-meta {
		font-size: 0.84rem;
		color: #475467;
		margin-top: 4px;
	}

	.local-draft-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 10px;
	}

	.outline-summary {
		margin-bottom: 12px;
	}

	.outline-item {
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 10px 12px;
		background: #fbfdff;
	}

	.outline-item.active {
		border-color: #124f9c;
		box-shadow: 0 0 0 2px rgba(18, 79, 156, 0.14);
		background: #eef5ff;
	}

	.outline-item-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.outline-item-actions {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
		justify-content: flex-end;
	}

	.outline-item-title {
		font-size: 0.88rem;
		font-weight: 700;
		color: #1d2939;
	}

	.outline-item-meta {
		display: block;
		font-size: 0.76rem;
		color: #475467;
		margin-top: 4px;
	}

	.outline-item-button {
		border: 0;
		border-radius: 999px;
		padding: 6px 10px;
		font-size: 0.74rem;
		font-weight: 700;
		background: #124f9c;
		color: #fff;
		cursor: pointer;
	}

	.outline-item-button.secondary {
		background: #e9eef6;
		color: #1d2939;
	}

	.outline-item-button:disabled {
		opacity: 0.5;
		cursor: not-allowed;
	}

	.outline-review-row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 8px;
	}

	.outline-review-pill {
		display: inline-flex;
		align-items: center;
		border-radius: 999px;
		padding: 4px 8px;
		font-size: 0.74rem;
		font-weight: 700;
		background: #eef5ff;
		color: #124f9c;
	}

	.outline-review-pill.comment {
		background: #eef5ff;
		color: #124f9c;
	}

	.outline-review-pill.suggestion {
		background: #ecfdf3;
		color: #067647;
	}

	.outline-review-pill.clear {
		background: #eef2f6;
		color: #475467;
	}

	.review-queue-summary {
		margin-bottom: 12px;
	}

	.review-queue-item {
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 12px;
		background: #fbfdff;
	}

	.review-queue-item.active {
		border-color: #124f9c;
		box-shadow: 0 0 0 2px rgba(18, 79, 156, 0.14);
		background: #eef5ff;
	}

	.review-queue-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 12px;
	}

	.review-queue-title {
		font-size: 0.88rem;
		font-weight: 700;
		color: #1d2939;
	}

	.review-queue-body {
		margin-top: 8px;
		font-size: 0.82rem;
		line-height: 1.5;
		color: #344054;
	}

	.review-queue-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 10px;
	}

	.review-queue-meta {
		display: block;
		margin-top: 6px;
		font-size: 0.76rem;
		color: #475467;
	}

	.find-summary {
		margin-bottom: 12px;
	}

	.find-match {
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 10px 12px;
		background: #fbfdff;
	}

	.find-match.active {
		border-color: #124f9c;
		box-shadow: 0 0 0 2px rgba(18, 79, 156, 0.14);
		background: #eef5ff;
	}

	.find-match-snippet {
		font-size: 0.82rem;
		line-height: 1.5;
		color: #344054;
		white-space: pre-wrap;
	}

	.find-match-snippet mark {
		background: #fde68a;
		color: #92400e;
		padding: 0 2px;
		border-radius: 4px;
	}

	.find-match-meta {
		display: block;
		font-size: 0.74rem;
		color: #475467;
		margin-top: 6px;
	}

	.find-highlight-layer {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 39;
	}

	.find-highlight-rect {
		position: fixed;
		border-radius: 4px;
		background: rgba(253, 224, 71, 0.2);
		box-shadow: inset 0 0 0 1px rgba(202, 138, 4, 0.28);
	}

	.find-highlight-rect.active {
		background: rgba(251, 191, 36, 0.28);
		box-shadow: inset 0 0 0 2px rgba(180, 83, 9, 0.4);
	}

	.list-reset {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.list-reset li + li {
		margin-top: 10px;
	}

	.revision-meta {
		font-size: 0.9rem;
		color: #475467;
	}

	.revision-card {
		border: 1px solid #d6deea;
		border-radius: 12px;
		padding: 12px;
		background: #fbfdff;
	}

	.revision-card.active {
		border-color: #124f9c;
		box-shadow: 0 0 0 2px rgba(18, 79, 156, 0.16);
	}

	.revision-list-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 10px;
