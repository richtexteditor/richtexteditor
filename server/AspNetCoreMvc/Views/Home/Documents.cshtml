		var endTextNodeOffset = safeEnd - endTextNode.startOffset;
		if (startTextNodeOffset < 0 ||
			endTextNodeOffset < 0 ||
			startTextNodeOffset > startTextNode.text.length ||
			endTextNodeOffset > endTextNode.text.length) {
