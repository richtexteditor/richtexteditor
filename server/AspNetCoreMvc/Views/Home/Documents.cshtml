	async function setCommentThreadStatus(threadId, status) {
		if (!currentDocumentId) {
			setStatus("Load a document before updating comment threads.", "error");
			return;
		}

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(currentDocumentId) + "/comments/" + encodeURIComponent(threadId) + "/status", {
