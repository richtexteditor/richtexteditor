	function buildRevisionCompareRows(baseLines, draftLines) {
		var leftLines = Array.isArray(baseLines) ? baseLines : [];
		var rightLines = Array.isArray(draftLines) ? draftLines : [];
		var lcs = [];
		for (var rowIndex = 0; rowIndex <= leftLines.length; rowIndex++) {
			lcs[rowIndex] = [];
			for (var colIndex = 0; colIndex <= rightLines.length; colIndex++) {
				lcs[rowIndex][colIndex] = 0;
			}
		}

		for (var leftIndex = leftLines.length - 1; leftIndex >= 0; leftIndex -= 1) {
			for (var rightIndex = rightLines.length - 1; rightIndex >= 0; rightIndex -= 1) {
				lcs[leftIndex][rightIndex] = leftLines[leftIndex] === rightLines[rightIndex]
					? lcs[leftIndex + 1][rightIndex + 1] + 1
					: Math.max(lcs[leftIndex + 1][rightIndex], lcs[leftIndex][rightIndex + 1]);
			}
		}

		var operations = [];
		var leftCursor = 0;
		var rightCursor = 0;
		while (leftCursor < leftLines.length && rightCursor < rightLines.length) {
			if (leftLines[leftCursor] === rightLines[rightCursor]) {
				operations.push({
					type: "equal",
					left: leftLines[leftCursor],
					right: rightLines[rightCursor]
				});
				leftCursor += 1;
				rightCursor += 1;
			}
			else if (lcs[leftCursor + 1][rightCursor] >= lcs[leftCursor][rightCursor + 1]) {
				operations.push({
					type: "remove",
					left: leftLines[leftCursor],
					right: ""
				});
				leftCursor += 1;
			}
			else {
				operations.push({
					type: "add",
					left: "",
					right: rightLines[rightCursor]
				});
				rightCursor += 1;
			}
		}

		while (leftCursor < leftLines.length) {
			operations.push({
				type: "remove",
				left: leftLines[leftCursor],
				right: ""
			});
			leftCursor += 1;
		}

		while (rightCursor < rightLines.length) {
			operations.push({
				type: "add",
				left: "",
				right: rightLines[rightCursor]
			});
			rightCursor += 1;
		}

		var rows = [];
		var changedCount = 0;
		var addedCount = 0;
		var removedCount = 0;
		var unchangedCount = 0;
		var operationIndex = 0;
		while (operationIndex < operations.length) {
			var currentOperation = operations[operationIndex];
			if (currentOperation.type === "equal") {
				rows.push({
					type: "equal",
					left: currentOperation.left,
					right: currentOperation.right
				});
				unchangedCount += 1;
				operationIndex += 1;
				continue;
			}

			var removedGroup = [];
			var addedGroup = [];
			while (operationIndex < operations.length && operations[operationIndex].type !== "equal") {
				if (operations[operationIndex].type === "remove") {
					removedGroup.push(operations[operationIndex].left);
				}
				else {
					addedGroup.push(operations[operationIndex].right);
				}

				operationIndex += 1;
			}

			var pairedCount = Math.min(removedGroup.length, addedGroup.length);
			for (var pairIndex = 0; pairIndex < pairedCount; pairIndex += 1) {
				rows.push({
					type: "change",
					left: removedGroup[pairIndex],
					right: addedGroup[pairIndex]
				});
				changedCount += 1;
			}

			for (var removedIndex = pairedCount; removedIndex < removedGroup.length; removedIndex += 1) {
				rows.push({
					type: "remove",
					left: removedGroup[removedIndex],
					right: ""
				});
				removedCount += 1;
			}

			for (var addedIndex = pairedCount; addedIndex < addedGroup.length; addedIndex += 1) {
				rows.push({
					type: "add",
					left: "",
					right: addedGroup[addedIndex]
				});
				addedCount += 1;
			}
		}

		return {
			rows: rows,
			summary: {
				addedCount: addedCount,
				removedCount: removedCount,
				changedCount: changedCount,
				unchangedCount: unchangedCount
			}
		};
	}

	function renderRevisionCompareState(compareState) {
		var compareButton = document.getElementById("compareLatestRevisionButton");
		var clearButton = document.getElementById("clearRevisionCompareButton");
		var summary = document.getElementById("revisionCompareSummary");
		var details = document.getElementById("revisionCompareDetails");
		if (!compareButton || !clearButton || !summary || !details) {
			return;
		}

		compareButton.disabled = !latestRevisionSummaries.length || !currentDocumentId;
		clearButton.disabled = !compareState;
		details.innerHTML = "";

		if (!compareState) {
			summary.textContent = currentDocumentId
				? "Choose a saved revision to compare against the current draft."
				: "Load a saved document to compare a stored revision with the current draft.";
			return;
		}

		var diffSummary = compareState.diff.summary;
		if (!compareState.diff.rows.length ||
			(diffSummary.addedCount === 0 && diffSummary.removedCount === 0 && diffSummary.changedCount === 0)) {
			summary.textContent = compareState.revision.revisionId
				+ " matches the current draft."
				+ (hasUnsavedChanges ? " There are no unsaved text-level differences right now." : "");
		}
		else {
			summary.textContent = compareState.revision.revisionId
				+ " vs current draft: "
				+ diffSummary.changedCount
				+ " changed line pair(s), "
				+ diffSummary.addedCount
				+ " added line(s), "
				+ diffSummary.removedCount
				+ " removed line(s).";
		}

		if (!compareState.diff.rows.length) {
			var emptyState = document.createElement("div");
			emptyState.className = "inline-note";
			emptyState.textContent = "No comparable text blocks were found in either document snapshot.";
			details.appendChild(emptyState);
			return;
		}

		compareState.diff.rows.forEach(function (row) {
			var rowElement = document.createElement("div");
			rowElement.className = "revision-compare-row " + row.type;

			var leftSide = document.createElement("div");
			leftSide.className = "revision-compare-side";
			var leftTitle = document.createElement("div");
			leftTitle.className = "revision-compare-side-title";
			leftTitle.textContent = compareState.revision.revisionId + " saved text";
			var leftText = document.createElement("div");
			leftText.className = "revision-compare-text" + (row.left ? "" : " empty");
			leftText.textContent = row.left || "(No text on this side)";
			leftSide.appendChild(leftTitle);
			leftSide.appendChild(leftText);

			var rightSide = document.createElement("div");
			rightSide.className = "revision-compare-side";
			var rightTitle = document.createElement("div");
			rightTitle.className = "revision-compare-side-title";
			rightTitle.textContent = "Current draft";
			var rightText = document.createElement("div");
			rightText.className = "revision-compare-text" + (row.right ? "" : " empty");
			rightText.textContent = row.right || "(No text on this side)";
			rightSide.appendChild(rightTitle);
			rightSide.appendChild(rightText);

			rowElement.appendChild(leftSide);
			rowElement.appendChild(rightSide);
			details.appendChild(rowElement);
		});
	}

	async function compareRevisionToCurrentDraft(revisionId) {
		if (!currentDocumentId) {
			setStatus("Load a document before comparing revisions.", "error");
			return;
		}

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(currentDocumentId) + "/revisions/" + encodeURIComponent(revisionId));
			if (!response.ok) {
				throw new Error(await readError(response, "Unable to load the selected revision."));
			}

			var revision = await response.json();
			activeComparedRevisionId = revision.revisionId || revisionId;
			latestComparedRevisionSnapshot = revision;
			refreshActiveRevisionCompare();
			if (latestRevisionSummaries.length) {
				renderRevisions(latestRevisionSummaries);
			}
			setStatus("Compared " + (revision.revisionId || revisionId) + " against the current draft.", "success");
		}
		catch (error) {
			setStatus(error.message || "Unable to compare the selected revision.", "error");
		}
	}

	function compareLatestRevisionToDraft() {
		if (!latestRevisionSummaries.length) {
			setStatus("No saved revisions are available to compare yet.", "error");
			return;
		}

		compareRevisionToCurrentDraft(latestRevisionSummaries[0].revisionId);
	}

	function collectStructuredTextNodeEntries(node, path, results) {
		if (!node || typeof node !== "object") {
			return;
		}

		if (node.type === "text") {
			var text = normalizePlainText(node.text || "");
			if (text) {
				results.push({
					path: cloneAnchorPath(path),
					pathKey: getAnchorPathKey(path),
					text: text
				});
			}
			return;
		}

		var content = Array.isArray(node.content) ? node.content : [];
		for (var childIndex = 0; childIndex < content.length; childIndex++) {
			collectStructuredTextNodeEntries(content[childIndex], path.concat(childIndex), results);
		}
	}

	function buildStructuredDocumentIndex(documentModel) {
		var index = {
			blockByKey: {},
			blocks: [],
			fullText: "",
			textNodeByKey: {},
			textNodes: []
		};

		if (!documentModel || typeof documentModel !== "object") {
			return index;
		}

		function pushTextNodes(node, path, blockEntry) {
			var collected = [];
			collectStructuredTextNodeEntries(node, path, collected);
			if (!collected.length) {
				return;
			}

			var blockCursor = 0;
			collected.forEach(function (textNode) {
				var localStart = blockEntry.text.indexOf(textNode.text, blockCursor);
				if (localStart < 0) {
					localStart = blockEntry.text.indexOf(textNode.text);
				}

				if (localStart < 0) {
					return;
				}

				var localEnd = localStart + textNode.text.length;
				var entry = {
					block: blockEntry,
					blockEndOffset: localEnd,
					blockPath: cloneAnchorPath(blockEntry.path),
					blockPathKey: blockEntry.pathKey,
					blockStartOffset: localStart,
					blockType: blockEntry.type,
					endOffset: blockEntry.startOffset + localEnd,
					path: cloneAnchorPath(textNode.path),
					pathKey: textNode.pathKey,
					startOffset: blockEntry.startOffset + localStart,
					text: textNode.text,
					type: "text"
				};

				index.textNodes.push(entry);
				index.textNodeByKey[entry.pathKey] = entry;
				blockCursor = localEnd;
			});
		}

		function pushBlock(node, path) {
			var text = getStructuredNodeText(node);
			if (!text) {
				return;
			}

			var startOffset = index.fullText.length;
			if (index.fullText) {
				index.fullText += " ";
				startOffset += 1;
			}

			index.fullText += text;
			var entry = {
				endOffset: startOffset + text.length,
				path: cloneAnchorPath(path),
				pathKey: getAnchorPathKey(path),
				startOffset: startOffset,
				text: text,
				type: node.type
			};

			index.blocks.push(entry);
			index.blockByKey[entry.pathKey] = entry;
			pushTextNodes(node, path, entry);
