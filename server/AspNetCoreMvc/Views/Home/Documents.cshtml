	function filterCommandPaletteCommands(query) {
		var normalizedQuery = String(query || "").trim().toLowerCase();
		var commands = getCommandPaletteCommands();
		if (!normalizedQuery) {
			return commands;
		}

		return commands.filter(function (command) {
			var haystack = [
				command.group,
				command.label,
				command.description,
				command.keywords
			].join(" ").toLowerCase();
			return haystack.indexOf(normalizedQuery) >= 0;
		});
	}

	function renderCommandPalette() {
		var overlay = document.getElementById("commandPaletteOverlay");
		var list = document.getElementById("commandPaletteList");
		var hint = document.getElementById("commandPaletteHint");
		var input = document.getElementById("commandPaletteInput");
		if (!overlay || !list || !hint || !input) {
			return;
		}

		commandPaletteVisibleCommands = filterCommandPaletteCommands(commandPaletteState.query);
		if (commandPaletteState.activeIndex >= commandPaletteVisibleCommands.length) {
			commandPaletteState.activeIndex = Math.max(0, commandPaletteVisibleCommands.length - 1);
		}

		list.innerHTML = "";
		if (!commandPaletteVisibleCommands.length) {
			var emptyItem = document.createElement("li");
			emptyItem.className = "command-palette-item";
			emptyItem.textContent = "No commands match this search yet.";
			list.appendChild(emptyItem);
			hint.textContent = "Try terms like insert, ai, markdown, or suggestion.";
			return;
		}

		hint.textContent = commandPaletteVisibleCommands.length + " command" + (commandPaletteVisibleCommands.length === 1 ? "" : "s") + " ready. Arrow keys move, Enter runs the active command.";

		commandPaletteVisibleCommands.forEach(function (command, index) {
			var item = document.createElement("li");
			item.className = "command-palette-item";

			var button = document.createElement("button");
			button.type = "button";
			button.className = "command-palette-button" + (index === commandPaletteState.activeIndex ? " active" : "");
			button.onclick = function () {
				commandPaletteState.activeIndex = index;
				executeActiveCommandPaletteItem();
			};

			var header = document.createElement("div");
			header.className = "command-palette-item-header";

			var label = document.createElement("span");
			label.className = "command-palette-item-label";
			label.textContent = command.label;

			header.appendChild(label);
			if (command.shortcut) {
				var shortcut = document.createElement("span");
				shortcut.className = "command-palette-item-shortcut";
				shortcut.textContent = command.shortcut;
				header.appendChild(shortcut);
			}

			var meta = document.createElement("span");
			meta.className = "command-palette-item-meta";
			meta.textContent = command.group;

			var description = document.createElement("span");
			description.className = "command-palette-item-description";
			description.textContent = command.description;

			button.appendChild(header);
			button.appendChild(meta);
			button.appendChild(description);
			item.appendChild(button);
			list.appendChild(item);
		});
	}

	function openCommandPalette(initialQuery) {
		var overlay = document.getElementById("commandPaletteOverlay");
		var input = document.getElementById("commandPaletteInput");
		if (!overlay || !input) {
			return;
		}

		closeSlashCommandMenu();
		hideBlockToolsBar();
		commandPaletteState.isOpen = true;
		hideSelectionActionBar();
		commandPaletteState.query = typeof initialQuery === "string" ? initialQuery : "";
		commandPaletteState.activeIndex = 0;
		overlay.style.display = "flex";
		document.body.style.overflow = "hidden";
		input.value = commandPaletteState.query;
		renderCommandPalette();
		window.setTimeout(function () {
			input.focus();
			input.select();
		}, 0);
	}

	function closeCommandPalette() {
		var overlay = document.getElementById("commandPaletteOverlay");
		if (!overlay) {
			return;
		}

		commandPaletteState.isOpen = false;
		commandPaletteState.query = "";
		commandPaletteState.activeIndex = 0;
		commandPaletteVisibleCommands = [];
		overlay.style.display = "none";
		document.body.style.overflow = "";
		scheduleSelectionActionBarRefresh();
		scheduleSlashCommandMenuRefresh();
		scheduleBlockToolsRefresh();
	}

	function handleCommandPaletteInput() {
		var input = document.getElementById("commandPaletteInput");
		commandPaletteState.query = input ? input.value : "";
		commandPaletteState.activeIndex = 0;
		renderCommandPalette();
	}

	function handleCommandPaletteKeydown(event) {
		if (!commandPaletteState.isOpen) {
			return;
		}

		if (event.key === "ArrowDown") {
			event.preventDefault();
			if (commandPaletteVisibleCommands.length) {
				commandPaletteState.activeIndex = Math.min(commandPaletteState.activeIndex + 1, commandPaletteVisibleCommands.length - 1);
				renderCommandPalette();
			}
			return;
		}

		if (event.key === "ArrowUp") {
			event.preventDefault();
			if (commandPaletteVisibleCommands.length) {
				commandPaletteState.activeIndex = Math.max(commandPaletteState.activeIndex - 1, 0);
				renderCommandPalette();
			}
			return;
		}

		if (event.key === "Enter") {
			event.preventDefault();
			executeActiveCommandPaletteItem();
		}
	}

	function executeActiveCommandPaletteItem() {
		var command = commandPaletteVisibleCommands[commandPaletteState.activeIndex];
		if (!command || typeof command.action !== "function") {
			return;
		}

		closeCommandPalette();
		try {
			var result = command.action();
			if (result && typeof result.then === "function") {
				result.catch(function () {
				});
			}
		}
		catch (error) {
			setStatus(error.message || "Unable to run that command.", "error");
		}
	}

	function handleCommandPaletteOverlayClick(event) {
		if (event && event.target && event.target.id === "commandPaletteOverlay") {
			closeCommandPalette();
		}
	}

	function setMarkdownLabValue(value) {
