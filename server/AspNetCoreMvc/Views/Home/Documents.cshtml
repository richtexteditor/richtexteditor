			return Array.isArray(node.content) && node.content.length
				? node.content.length + " child nodes"
				: "No direct text content";
		}

		return preview.length > 110 ? preview.substring(0, 107) + "..." : preview;
	}

	function collectStructureExplorerNodes(node, path, depth, nodes, counts) {
		if (!node || typeof node !== "object") {
			return;
		}

		var type = node.type || "doc";
		counts.total += 1;
		counts.byType[type] = (counts.byType[type] || 0) + 1;

		nodes.push({
			node: node,
			path: Array.isArray(path) ? path.slice() : [],
			pathKey: formatStructurePath(path),
			depth: depth || 0,
			label: getStructureNodeLabel(node),
			preview: getStructureNodePreview(node),
			textLength: getStructuredNodeText(node).length
		});

		var content = Array.isArray(node.content) ? node.content : [];
		for (var index = 0; index < content.length; index += 1) {
			collectStructureExplorerNodes(content[index], (path || []).concat(index), (depth || 0) + 1, nodes, counts);
		}
	}

	function renderStructureSummary(counts) {
		var summary = document.getElementById("structureSummary");
		if (!summary) {
			return;
		}

		summary.innerHTML = "";
		var pills = [
			counts.total + " nodes",
			(counts.byType.paragraph || 0) + " paragraphs",
			(counts.byType.heading || 0) + " headings",
			((counts.byType.bulletList || 0) + (counts.byType.orderedList || 0)) + " lists",
			(counts.byType.table || 0) + " tables",
			(counts.byType.text || 0) + " text nodes"
		];

		pills.forEach(function (label) {
			var item = document.createElement("span");
			item.className = "structure-pill";
			item.textContent = label;
			summary.appendChild(item);
		});
	}

	function renderStructureDetail(nodeInfo) {
		var title = document.getElementById("structureDetailTitle");
		var meta = document.getElementById("structureDetailMeta");
		var json = document.getElementById("structureDetailJson");
		if (!title || !meta || !json) {
			return;
		}

		if (!nodeInfo) {
			title.textContent = "Document root";
			meta.textContent = "Select a node to inspect its path, text, and raw JSON.";
			json.value = "{}";
			return;
		}

		title.textContent = nodeInfo.label;
		meta.textContent = "Path " + nodeInfo.pathKey
			+ " | " + nodeInfo.textLength + " text chars"
			+ (nodeInfo.preview ? " | " + nodeInfo.preview : "");
		json.value = JSON.stringify(nodeInfo.node, null, 2);
	}

	function selectStructureNode(pathKey) {
		selectedStructureNodePathKey = pathKey || "root";
		renderStructureExplorer(getEditorDocumentModel());
	}

	function scheduleOutlineRefresh() {
		window.clearTimeout(outlineRefreshTimer);
		outlineRefreshTimer = window.setTimeout(function () {
			renderDocumentOutline(getEditorDocumentModel());
		}, 40);
	}

	function ensureOutlineListeners() {
		var editorDocument = getEditorDocument();
		if (!editorDocument || editorDocument.__outlineReady) {
			return;
		}

		editorDocument.__outlineReady = true;
		editorDocument.addEventListener("selectionchange", scheduleOutlineRefresh);
		editorDocument.addEventListener("mouseup", function () {
			window.setTimeout(scheduleOutlineRefresh, 0);
		});
		editorDocument.addEventListener("keyup", function () {
			window.setTimeout(scheduleOutlineRefresh, 0);
		});
		editorDocument.addEventListener("mousedown", function () {
			window.setTimeout(scheduleOutlineRefresh, 0);
		});
		editorDocument.addEventListener("scroll", scheduleOutlineRefresh, true);
	}

	function collectDocumentOutlineEntries(node, path, entries) {
		if (!node || typeof node !== "object") {
			return;
		}

		if (node.type === "heading") {
			entries.push({
				level: ((node.attrs && node.attrs.level) || 1),
				path: Array.isArray(path) ? path.slice() : [],
				pathKey: getAnchorPathKey(path),
				text: getStructuredNodeText(node) || "Untitled heading"
			});
		}

		var content = Array.isArray(node.content) ? node.content : [];
		for (var index = 0; index < content.length; index += 1) {
			collectDocumentOutlineEntries(content[index], (path || []).concat(index), entries);
		}
	}

	function getDocumentOutlineEntries(documentModel) {
		var entries = [];
		collectDocumentOutlineEntries(documentModel, [], entries);
		return entries;
	}

	function getOutlineSectionEntries(documentModel, structuredIndex) {
		var entries = getDocumentOutlineEntries(documentModel);
		if (!entries.length) {
			return [];
		}

		var effectiveStructuredIndex = structuredIndex || buildStructuredDocumentIndex(documentModel);
		var sections = [];
		entries.forEach(function (entry, entryIndex) {
			var block = effectiveStructuredIndex && effectiveStructuredIndex.blockByKey
				? effectiveStructuredIndex.blockByKey[entry.pathKey]
				: null;
			if (!block) {
				return;
			}

			var endOffset = effectiveStructuredIndex.fullText ? effectiveStructuredIndex.fullText.length : block.endOffset;
			for (var nextIndex = entryIndex + 1; nextIndex < entries.length; nextIndex += 1) {
				var nextBlock = effectiveStructuredIndex.blockByKey[entries[nextIndex].pathKey];
				if (nextBlock) {
					endOffset = nextBlock.startOffset;
					break;
				}
			}

			sections.push({
				endOffset: endOffset,
				level: entry.level,
				path: cloneAnchorPath(entry.path),
				pathKey: entry.pathKey,
				startOffset: block.startOffset,
				text: entry.text
			});
		});

		return sections;
	}

	function getCurrentDocumentOffset() {
		var caretSnapshot = getEditorCaretSnapshot();
		if (caretSnapshot && caretSnapshot.caretOffset !== null && caretSnapshot.caretOffset !== undefined) {
			return caretSnapshot.caretOffset;
		}

		var selectionSnapshot = getEditorSelectionSnapshot();
		if (selectionSnapshot && selectionSnapshot.startOffset !== null && selectionSnapshot.startOffset !== undefined) {
			return selectionSnapshot.startOffset;
		}

		return null;
	}

	function getActiveOutlineHeadingPathKey(entries, structuredIndex) {
		if (!entries || !entries.length || !structuredIndex) {
			return "";
		}

		var currentOffset = getCurrentDocumentOffset();
		if (currentOffset === null || currentOffset === undefined) {
			return activeOutlineHeadingPathKey || entries[0].pathKey;
		}

		var activeEntry = null;
		entries.forEach(function (entry) {
			var block = structuredIndex.blockByKey[entry.pathKey];
			if (!block) {
				return;
			}

			if (block.startOffset <= currentOffset) {
				if (!activeEntry || block.startOffset >= structuredIndex.blockByKey[activeEntry.pathKey].startOffset) {
					activeEntry = entry;
				}
			}
		});

		return activeEntry ? activeEntry.pathKey : entries[0].pathKey;
	}

	function getCurrentReviewSectionPathKey(structuredIndex, outlineSections) {
		var sections = outlineSections || getOutlineSectionEntries(getEditorDocumentModel(), structuredIndex);
		if (!sections.length) {
			return "";
		}

		return getActiveOutlineHeadingPathKey(sections, structuredIndex || buildStructuredDocumentIndex(getEditorDocumentModel()));
	}

	function getReviewItemSectionEntry(item, liveAnchor, outlineSections, structuredIndex) {
		var sections = outlineSections || getOutlineSectionEntries(getEditorDocumentModel(), structuredIndex);
		if (!sections.length || !item) {
			return null;
		}

		var resolvedAnchor = liveAnchor || (structuredIndex ? getThreadLiveAnchor(item, structuredIndex) : null);
		var candidatePathKey = "";
		var candidateOffset = null;
		if (resolvedAnchor && resolvedAnchor.block && resolvedAnchor.block.pathKey) {
			candidatePathKey = resolvedAnchor.block.pathKey;
			candidateOffset = resolvedAnchor.block.startOffset;
		}
		else if (resolvedAnchor && resolvedAnchor.startTextNode && resolvedAnchor.startTextNode.blockPathKey) {
			candidatePathKey = resolvedAnchor.startTextNode.blockPathKey;
			candidateOffset = resolvedAnchor.startTextNode.block.startOffset;
		}
		else if (item.anchorBlockPath && item.anchorBlockPath.length) {
			candidatePathKey = getAnchorPathKey(item.anchorBlockPath);
		}

		if ((candidateOffset === null || candidateOffset === undefined) && resolvedAnchor && resolvedAnchor.startOffset !== null && resolvedAnchor.startOffset !== undefined) {
			candidateOffset = resolvedAnchor.startOffset;
		}

		if ((candidateOffset === null || candidateOffset === undefined) && item.anchorStartOffset !== null && item.anchorStartOffset !== undefined) {
			candidateOffset = item.anchorStartOffset;
		}

		if (candidatePathKey) {
			for (var directIndex = sections.length - 1; directIndex >= 0; directIndex -= 1) {
				if (sections[directIndex].pathKey === candidatePathKey) {
					return sections[directIndex];
				}
			}

			var effectiveStructuredIndex = structuredIndex || buildStructuredDocumentIndex(getEditorDocumentModel());
			var blockEntry = effectiveStructuredIndex.blockByKey[candidatePathKey];
			if (blockEntry) {
				candidateOffset = blockEntry.startOffset;
			}
		}

		if (candidateOffset === null || candidateOffset === undefined) {
			return sections[0] || null;
		}

		var matchedSection = sections[0] || null;
		sections.forEach(function (section) {
			if (section.startOffset <= candidateOffset) {
				matchedSection = section;
			}
		});
		return matchedSection;
	}

	function buildOutlineReviewStats(outlineSections, structuredIndex) {
		var sections = outlineSections || [];
		var effectiveStructuredIndex = structuredIndex || buildStructuredDocumentIndex(getEditorDocumentModel());
		var statsByPath = {};

		sections.forEach(function (section) {
			statsByPath[section.pathKey] = {
				acceptedSuggestions: 0,
				firstOpenCommentId: "",
				firstOpenSuggestionId: "",
				openSuggestions: 0,
				openThreads: 0,
				rejectedSuggestions: 0,
				resolvedThreads: 0,
				totalSuggestions: 0,
				totalThreads: 0
			};
		});

		(latestCommentThreads || []).forEach(function (thread) {
			var liveAnchor = getThreadLiveAnchor(thread, effectiveStructuredIndex);
			var sectionInfo = getReviewItemSectionEntry(thread, liveAnchor, sections, effectiveStructuredIndex);
			if (!sectionInfo || !statsByPath[sectionInfo.pathKey]) {
				return;
			}

			var stats = statsByPath[sectionInfo.pathKey];
			stats.totalThreads += 1;
			if (thread.status === "resolved") {
				stats.resolvedThreads += 1;
			}
			else {
				stats.openThreads += 1;
				if (!stats.firstOpenCommentId) {
					stats.firstOpenCommentId = thread.threadId;
				}
			}
		});

		(latestSuggestions || []).forEach(function (suggestion) {
			var liveAnchor = getThreadLiveAnchor(suggestion, effectiveStructuredIndex);
			var sectionInfo = getReviewItemSectionEntry(suggestion, liveAnchor, sections, effectiveStructuredIndex);
			if (!sectionInfo || !statsByPath[sectionInfo.pathKey]) {
				return;
			}

			var stats = statsByPath[sectionInfo.pathKey];
			stats.totalSuggestions += 1;
			if (suggestion.status === "accepted") {
				stats.acceptedSuggestions += 1;
			}
			else if (suggestion.status === "rejected") {
				stats.rejectedSuggestions += 1;
			}
			else {
				stats.openSuggestions += 1;
				if (!stats.firstOpenSuggestionId) {
					stats.firstOpenSuggestionId = suggestion.suggestionId;
				}
			}
		});

		return statsByPath;
	}

	function renderReviewQueue(documentModel) {
		var summary = document.getElementById("reviewQueueSummary");
		var list = document.getElementById("reviewQueueList");
		var previousButton = document.getElementById("reviewQueuePreviousButton");
		var nextButton = document.getElementById("reviewQueueNextButton");
		if (!summary || !list || !previousButton || !nextButton) {
			return;
		}

		reviewQueueItemsSnapshot = buildReviewQueueItems(documentModel);
		var activeIndex = getReviewQueueActiveIndex(reviewQueueItemsSnapshot);
		list.innerHTML = "";

		if (!reviewQueueItemsSnapshot.length) {
			summary.textContent = "No open review items yet. Add a comment thread or open suggestion to build the queue.";
			previousButton.disabled = true;
			nextButton.disabled = true;
			var emptyItem = document.createElement("li");
			emptyItem.textContent = "Open review items will appear here in document order.";
			list.appendChild(emptyItem);
			return;
		}

		var sectionCount = {};
		reviewQueueItemsSnapshot.forEach(function (item) {
			sectionCount[item.sectionText] = true;
		});
		summary.textContent = "Showing "
			+ reviewQueueItemsSnapshot.length
			+ " open review item(s) across "
			+ Object.keys(sectionCount).length
			+ " section(s). Use Previous / Next issue or Alt+Shift+J / Alt+Shift+K. Accept with Alt+Shift+A and reject or resolve with Alt+Shift+R.";
		previousButton.disabled = false;
		nextButton.disabled = false;

		reviewQueueItemsSnapshot.forEach(function (item, itemIndex) {
			var queueItem = document.createElement("li");
			queueItem.className = "review-queue-item" + (item.queueKey === activeReviewQueueKey ? " active" : "");

			var header = document.createElement("div");
			header.className = "review-queue-header";

			var titleBlock = document.createElement("div");
			var title = document.createElement("div");
			title.className = "review-queue-title";
			title.textContent = getReviewQueueItemLabel(item) + " - \"" + item.title + "\"";

			var meta = document.createElement("span");
			meta.className = "review-queue-meta";
			meta.textContent = item.sectionText
				+ " - updated "
				+ new Date(item.updatedUtc || Date.now()).toLocaleString()
				+ (itemIndex === activeIndex ? " - active" : "");

			titleBlock.appendChild(title);
			titleBlock.appendChild(meta);

			var openButton = document.createElement("button");
			openButton.type = "button";
			openButton.className = "thread-action primary";
			openButton.textContent = item.queueKey === activeReviewQueueKey ? "Open" : "Go";
			openButton.onclick = function () {
				openReviewQueueItem(item);
			};

			var body = document.createElement("div");
			body.className = "review-queue-body";
			body.textContent = item.body;

			var sectionChip = document.createElement("div");
			sectionChip.className = "review-section-chip" + (item.sectionInfo && item.sectionInfo.pathKey === activeOutlineHeadingPathKey ? " active" : "");
			sectionChip.textContent = "Section: " + item.sectionText;

			var actions = document.createElement("div");
			actions.className = "review-queue-actions";

			if (item.kind === "suggestion") {
				var acceptButton = document.createElement("button");
				acceptButton.type = "button";
				acceptButton.className = "thread-action";
				acceptButton.textContent = "Accept";
				acceptButton.onclick = async function () {
					await runReviewQueueItemAction(item, "accept");
				};

				var rejectButton = document.createElement("button");
				rejectButton.type = "button";
				rejectButton.className = "thread-action";
				rejectButton.textContent = "Reject";
				rejectButton.onclick = async function () {
					await runReviewQueueItemAction(item, "reject");
				};

				actions.appendChild(acceptButton);
				actions.appendChild(rejectButton);
			}
			else {
				var replyButton = document.createElement("button");
				replyButton.type = "button";
				replyButton.className = "thread-action";
				replyButton.textContent = "Reply";
				replyButton.onclick = async function () {
					await runReviewQueueItemAction(item, "reply");
				};

				var resolveButton = document.createElement("button");
				resolveButton.type = "button";
				resolveButton.className = "thread-action";
				resolveButton.textContent = "Resolve";
				resolveButton.onclick = async function () {
					await runReviewQueueItemAction(item, "resolve");
				};

				actions.appendChild(replyButton);
				actions.appendChild(resolveButton);
			}

			header.appendChild(titleBlock);
			header.appendChild(openButton);
			queueItem.appendChild(header);
			queueItem.appendChild(sectionChip);
			queueItem.appendChild(body);
			queueItem.appendChild(actions);
			list.appendChild(queueItem);
		});
	}

	function openReviewQueueItem(item) {
		if (!item) {
			return false;
		}

		if (item.kind === "suggestion") {
			locateSuggestion(item.id);
			return true;
		}

		locateCommentThread(item.id);
		return true;
	}

	async function runReviewQueueItemAction(item, action) {
		if (!item || !action) {
			return false;
		}

		if (action === "open") {
			return openReviewQueueItem(item);
		}

		var nextItem = (action === "accept" || action === "reject" || action === "resolve")
			? getAdjacentReviewQueueItem(item, 1)
			: null;

		if (item.kind === "suggestion") {
			switch (action) {
				case "accept":
					await setSuggestionStatus(item.id, "accepted");
					if (nextItem) {
						openReviewQueueItem(nextItem);
					}
					return true;
				case "reject":
					await setSuggestionStatus(item.id, "rejected");
					if (nextItem) {
						openReviewQueueItem(nextItem);
					}
					return true;
				default:
					return false;
			}
		}

		if (item.kind === "comment") {
			switch (action) {
				case "resolve":
					await setCommentThreadStatus(item.id, "resolved");
					if (nextItem) {
						openReviewQueueItem(nextItem);
					}
					return true;
				case "reply":
					openInlineReplyComposer(item.id);
					return true;
				default:
					return false;
			}
		}

		return false;
	}

	function jumpReviewQueue(step) {
		var items = reviewQueueItemsSnapshot && reviewQueueItemsSnapshot.length
			? reviewQueueItemsSnapshot
			: buildReviewQueueItems(getEditorDocumentModel());
		if (!items.length) {
			setStatus("There are no open review items in the queue yet.", "error");
			return false;
		}

		var activeIndex = getReviewQueueActiveIndex(items);
		var targetIndex = activeIndex < 0
			? (step >= 0 ? 0 : items.length - 1)
			: (activeIndex + step + items.length) % items.length;
		return openReviewQueueItem(items[targetIndex]);
	}

	function openOutlineSectionReview(pathKey) {
		var documentModel = getEditorDocumentModel();
		var structuredIndex = buildStructuredDocumentIndex(documentModel);
		var outlineSections = getOutlineSectionEntries(documentModel, structuredIndex);
		if (!outlineSections.length) {
			setStatus("Add headings before opening section review from the outline.", "error");
			return;
		}

		var statsByPath = buildOutlineReviewStats(outlineSections, structuredIndex);
		var stats = statsByPath[pathKey];
		if (!stats || (!stats.firstOpenSuggestionId && !stats.firstOpenCommentId)) {
			setStatus("This section does not have any open review items yet.", "error");
			return;
		}

		locateOutlineHeading(pathKey);
		if (stats.firstOpenSuggestionId) {
			document.getElementById("suggestionCurrentSectionOnly").checked = true;
			document.getElementById("suggestionStatusFilter").value = "open";
			renderSuggestions(latestSuggestions);
			scheduleEditorHighlightRefresh();
			locateSuggestion(stats.firstOpenSuggestionId);
			return;
		}

		document.getElementById("commentCurrentSectionOnly").checked = true;
		document.getElementById("commentStatusFilter").value = "open";
		renderCommentThreads(latestCommentThreads);
		scheduleEditorHighlightRefresh();
		locateCommentThread(stats.firstOpenCommentId);
	}

	function locateOutlineHeading(pathKey) {
		var documentModel = getEditorDocumentModel();
		var structuredIndex = buildStructuredDocumentIndex(documentModel);
		var blockEntry = structuredIndex.blockByKey[pathKey];
		if (!blockEntry) {
			setStatus("That outline heading could not be resolved in the current draft.", "error");
			return;
		}

		var editorIndex = buildEditorDomTextIndex();
		if (!editorIndex) {
			setStatus("The editor is not ready for outline navigation yet.", "error");
			return;
		}

		var endOffset = Math.max(blockEntry.startOffset + 1, Math.min(blockEntry.endOffset, blockEntry.startOffset + Math.max(1, blockEntry.text.length)));
		var range = createEditorRangeFromOffsets(editorIndex, blockEntry.startOffset, endOffset);
		if (!range) {
			setStatus("The current heading could not be located in the editor view.", "error");
			return;
		}

		editor1.focus();
		var selection = editorIndex.document.defaultView && editorIndex.document.defaultView.getSelection
			? editorIndex.document.defaultView.getSelection()
			: null;
		if (selection) {
			selection.removeAllRanges();
			selection.addRange(range);
		}

		var targetElement = range.startContainer && range.startContainer.parentElement
			? range.startContainer.parentElement
			: editorIndex.document.body;
		if (targetElement && targetElement.scrollIntoView) {
			targetElement.scrollIntoView({ block: "center", behavior: "smooth" });
		}

		activeOutlineHeadingPathKey = pathKey;
		renderDocumentOutline(documentModel);
		setStatus("Jumped to the selected outline heading.", "success");
	}

	function renderDocumentOutline(documentModel) {
		var summary = document.getElementById("documentOutlineSummary");
		var list = document.getElementById("documentOutlineList");
		if (!summary || !list) {
			return;
		}

		var entries = getDocumentOutlineEntries(documentModel);
		if (!entries.length) {
			activeOutlineHeadingPathKey = "";
			summary.textContent = "Add headings to build a navigable outline for longer drafts.";
			list.innerHTML = "";
			return;
		}

		var structuredIndex = buildStructuredDocumentIndex(documentModel);
		var previousActivePathKey = activeOutlineHeadingPathKey;
		activeOutlineHeadingPathKey = getActiveOutlineHeadingPathKey(entries, structuredIndex);
		var outlineSections = getOutlineSectionEntries(documentModel, structuredIndex);
		var reviewStatsByPath = buildOutlineReviewStats(outlineSections, structuredIndex);
		var activeEntry = entries.find(function (entry) {
			return entry.pathKey === activeOutlineHeadingPathKey;
		}) || entries[0];

		summary.textContent = "Showing "
			+ entries.length
			+ " heading"
			+ (entries.length === 1 ? "" : "s")
			+ ". Current section: "
			+ activeEntry.text
			+ ".";

		list.innerHTML = "";
		entries.forEach(function (entry) {
			var reviewStats = reviewStatsByPath[entry.pathKey] || {
				openThreads: 0,
				openSuggestions: 0,
				totalThreads: 0,
				totalSuggestions: 0
			};
			var item = document.createElement("li");
			item.className = "outline-item" + (entry.pathKey === activeOutlineHeadingPathKey ? " active" : "");

			var header = document.createElement("div");
			header.className = "outline-item-header";

			var title = document.createElement("div");
			title.className = "outline-item-title";
			title.textContent = entry.text;
			title.style.paddingLeft = (Math.max(0, entry.level - 1) * 14) + "px";

			var button = document.createElement("button");
			button.type = "button";
			button.className = "outline-item-button";
			button.textContent = "Jump";
			button.onclick = function () {
				locateOutlineHeading(entry.pathKey);
			};

			var reviewButton = document.createElement("button");
			reviewButton.type = "button";
			reviewButton.className = "outline-item-button secondary";
			reviewButton.textContent = "Review";
			reviewButton.disabled = !reviewStats.openThreads && !reviewStats.openSuggestions;
			reviewButton.onclick = function () {
				openOutlineSectionReview(entry.pathKey);
			};

			var meta = document.createElement("span");
			meta.className = "outline-item-meta";
			meta.textContent = "H" + entry.level + " | Path " + formatStructurePath(entry.path);

			var actions = document.createElement("div");
			actions.className = "outline-item-actions";
			actions.appendChild(reviewButton);
			actions.appendChild(button);

			var reviewRow = document.createElement("div");
			reviewRow.className = "outline-review-row";
			if (reviewStats.openThreads) {
				var threadPill = document.createElement("span");
				threadPill.className = "outline-review-pill comment";
				threadPill.textContent = reviewStats.openThreads + " open thread" + (reviewStats.openThreads === 1 ? "" : "s");
				reviewRow.appendChild(threadPill);
			}
			if (reviewStats.openSuggestions) {
				var suggestionPill = document.createElement("span");
				suggestionPill.className = "outline-review-pill suggestion";
				suggestionPill.textContent = reviewStats.openSuggestions + " open suggestion" + (reviewStats.openSuggestions === 1 ? "" : "s");
				reviewRow.appendChild(suggestionPill);
			}
			if (!reviewStats.openThreads && !reviewStats.openSuggestions) {
				var clearPill = document.createElement("span");
				clearPill.className = "outline-review-pill clear";
				clearPill.textContent = (reviewStats.totalThreads || reviewStats.totalSuggestions)
					? "No open review items"
					: "No review items yet";
				reviewRow.appendChild(clearPill);
			}

			header.appendChild(title);
			header.appendChild(actions);
			item.appendChild(header);
			item.appendChild(meta);
			item.appendChild(reviewRow);
			list.appendChild(item);
		});

		if (previousActivePathKey !== activeOutlineHeadingPathKey && (latestCommentThreads.length || latestSuggestions.length)) {
			renderCommentThreads(latestCommentThreads);
			renderSuggestions(latestSuggestions);
		}
	}

	function getFindHighlightLayer() {
		return document.getElementById("findHighlightLayer");
	}

	function clearFindHighlights() {
		var layer = getFindHighlightLayer();
		if (layer) {
			layer.innerHTML = "";
		}
	}

	function scheduleFindRefresh() {
		window.clearTimeout(findRefreshTimer);
		findRefreshTimer = window.setTimeout(function () {
			renderFindResults(true);
		}, 40);
