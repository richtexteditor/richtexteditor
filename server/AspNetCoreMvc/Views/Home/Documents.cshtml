				]
			}
		]
	};
	var playgroundBlockCatalog = {
		section: {
			label: "Section header",
			html: "<h2>Section title</h2><p>Describe the goal, decision, or release detail here.</p>"
		},
		callout: {
			label: "Callout",
			html: "<p><strong>Callout:</strong> Highlight an important change, risk, or launch note for reviewers.</p>"
		},
		checklist: {
			label: "Checklist",
			html: "<ul><li>Review content</li><li>Confirm API response</li><li>Approve release note</li></ul>"
		},
		quote: {
