	function applyCurrentBlockTransformation(transformer, successMessage, options) {
		var context = getCurrentBlockToolsContext();
		if (!context) {
			setStatus("Place the cursor inside a supported block before using block tools.", "error");
			return false;
		}

		var documentModel = cloneStructuredDocumentModel(getEditorDocumentModel());
		var parentInfo = getParentContentInfo(documentModel, context.blockEntry.path);
		if (!documentModel || !parentInfo) {
			setStatus("The current block could not be resolved in the document model.", "error");
			return false;
		}

		var result = null;
		try {
			result = transformer(documentModel, parentInfo, context) || {};
		}
		catch (error) {
			setStatus(error.message || "Unable to update the current block.", "error");
			return false;
		}

		ensureDocumentHasRenderableBlock(documentModel);
		applyEditorDocument(documentModel, true);
		selectedStructureNodePathKey = result.nextPath ? formatStructurePath(result.nextPath) : selectedStructureNodePathKey;
		renderStructureExplorer(getEditorDocumentModel());
		scheduleBlockToolsRefresh();
		setStatus(successMessage, "success");
		return true;
	}

	function moveCurrentBlock(direction) {
		var delta = Number(direction || 0);
		if (!delta) {
			return false;
		}

		return applyCurrentBlockTransformation(function (documentModel, parentInfo, context) {
			var fromIndex = parentInfo.index;
			var toIndex = fromIndex + delta;
			if (toIndex < 0 || toIndex >= parentInfo.content.length) {
				throw new Error("This block cannot move any further.");
			}

			var moved = parentInfo.content.splice(fromIndex, 1)[0];
			parentInfo.content.splice(toIndex, 0, moved);
			return {
				nextPath: parentInfo.parentPath.concat(toIndex)
			};
		}, delta < 0 ? "Moved the current block up." : "Moved the current block down.");
	}

	function duplicateCurrentBlock() {
		return applyCurrentBlockTransformation(function (documentModel, parentInfo, context) {
			var clone = JSON.parse(JSON.stringify(parentInfo.content[parentInfo.index]));
			var nextIndex = parentInfo.index + 1;
			parentInfo.content.splice(nextIndex, 0, clone);
			return {
				nextPath: parentInfo.parentPath.concat(nextIndex)
			};
		}, "Duplicated the current block.");
	}

	function deleteCurrentBlock() {
		var context = getCurrentBlockToolsContext();
		if (!canDeleteCurrentBlockContext(context)) {
			setStatus("This block cannot be deleted because its parent needs at least one block to stay valid.", "error");
			return false;
		}

		return applyCurrentBlockTransformation(function (documentModel, parentInfo) {
			parentInfo.content.splice(parentInfo.index, 1);
			var nextIndex = Math.max(0, parentInfo.index - 1);
			return {
				nextPath: parentInfo.content.length ? parentInfo.parentPath.concat(Math.min(nextIndex, parentInfo.content.length - 1)) : parentInfo.parentPath
			};
		}, "Deleted the current block.");
	}

	function toggleCurrentBlockType() {
		var context = getCurrentBlockToolsContext();
		if (!context || !context.blockEntry || (context.blockEntry.type !== "paragraph" && context.blockEntry.type !== "heading")) {
			setStatus("Only paragraphs and headings can be converted with block tools right now.", "error");
			return false;
		}

		return applyCurrentBlockTransformation(function (documentModel, parentInfo) {
			var targetNode = parentInfo.content[parentInfo.index];
			if (targetNode.type === "heading") {
				targetNode.type = "paragraph";
				delete targetNode.attrs;
			}
			else {
				targetNode.type = "heading";
				targetNode.attrs = { level: 2 };
			}

			return {
				nextPath: parentInfo.parentPath.concat(parentInfo.index)
			};
		}, context.blockEntry.type === "heading"
			? "Turned the current heading into a paragraph."
			: "Turned the current paragraph into a heading.");
	}

