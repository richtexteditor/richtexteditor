	function refreshSelectionActionBar() {
		if (commandPaletteState.isOpen || slashCommandState.isOpen) {
			hideBlockToolsBar();
			hideSelectionActionBar();
			return;
		}

		var snapshot = getEditorSelectionSnapshot();
		if (!snapshot || !snapshot.rect) {
			hideSelectionActionBar();
			return;
		}

		var anchor = buildAnchorMetadata(snapshot.anchorText, snapshot);
		if (!anchor || !anchor.anchorText) {
			hideSelectionActionBar();
			return;
		}

		var bar = getSelectionActionBar();
		var preview = document.getElementById("selectionActionPreview");
		if (!bar || !preview) {
			return;
		}

		selectionActionBarState.visible = true;
		selectionActionBarState.anchor = cloneAnchorMetadata(anchor);
		selectionActionBarState.previewText = anchor.anchorText;
		preview.textContent = formatSelectionActionPreview(anchor.anchorText);

		bar.style.display = "flex";
		bar.setAttribute("aria-hidden", "false");

		var barWidth = bar.offsetWidth || 420;
		var barHeight = bar.offsetHeight || 54;
		var left = snapshot.rect.left + (snapshot.rect.width / 2) - (barWidth / 2);
		left = Math.max(8, Math.min(left, window.innerWidth - barWidth - 8));
		var top = snapshot.rect.top - barHeight - 12;
		if (top < 8) {
			top = snapshot.rect.bottom + 12;
		}

		bar.style.left = left + "px";
		bar.style.top = top + "px";
	}

	function resolveThreadEditorRange(thread, editorIndex, structuredIndex) {
		if (!thread || !editorIndex) {
			return null;
		}

		var liveAnchor = getThreadLiveAnchor(thread, structuredIndex);
		var domThread = liveAnchor.matched
			? {
				anchorContextAfter: thread.anchorContextAfter,
				anchorContextBefore: thread.anchorContextBefore,
				anchorEndOffset: liveAnchor.endOffset,
				anchorStartOffset: liveAnchor.startOffset,
				anchorText: thread.anchorText
			}
			: thread;
		var domAnchor = resolveThreadAnchorAgainstText(editorIndex.text, domThread, liveAnchor.matched ? liveAnchor.startOffset : null);
		if (!domAnchor.matched) {
			return null;
		}

		var range = createEditorRangeFromOffsets(editorIndex, domAnchor.startOffset, domAnchor.endOffset);
		if (!range) {
			return null;
		}

		return {
			domAnchor: domAnchor,
			liveAnchor: liveAnchor,
			range: range
		};
	}

