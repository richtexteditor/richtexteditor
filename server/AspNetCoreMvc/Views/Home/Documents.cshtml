		query: "",
		activeIndex: 0,
		manualOpen: false,
		context: null
	};
	var slashCommandVisibleCommands = [];
	var slashCommandRefreshTimer = 0;
	var blockToolsState = {
		visible: false,
		blockPath: null,
		blockPathKey: "",
		blockType: "",
		context: null
	};
	var blockToolsRefreshTimer = 0;
	var outlineRefreshTimer = 0;
	var findRefreshTimer = 0;
	var draftAutosaveTimer = 0;
	var lastDraftFingerprint = "";
	var lastDraftStorageKey = "";
	var pendingDraftRecovery = null;
	var DRAFT_AUTOSAVE_STORAGE_KEY = "rte-review-workspace:last-draft";
	var replyDrafts = {};
	var commentAnchorRefreshTimer = 0;
	var editorHighlightRefreshTimer = 0;
	var revisionCompareRefreshTimer = 0;
	var ANCHORABLE_BLOCK_TYPES = {
		codeBlock: true,
		heading: true,
		htmlBlock: true,
		paragraph: true
	};
	var sampleDocument = {
		type: "doc",
		version: 2,
		format: "richtexteditor-json",
		content: [
			{
				type: "heading",
				attrs: { level: 2 },
				content: [{ type: "text", text: "v2.3 alpha review workspace" }]
			},
			{
				type: "paragraph",
				content: [
					{ type: "text", text: "This sample is stored as a " },
					{ type: "text", text: "structured JSON document", marks: [{ type: "bold" }] },
					{ type: "text", text: " and each save now notifies other connected editors in the same document room while review metadata stays anchored to the current draft." }
				]
			},
			{
				type: "bulletList",
				content: [
					{
						type: "listItem",
						content: [{ type: "paragraph", content: [{ type: "text", text: "POST /api/documents" }] }]
					},
					{
						type: "listItem",
						content: [{ type: "paragraph", content: [{ type: "text", text: "PUT /api/documents/{id}" }] }]
