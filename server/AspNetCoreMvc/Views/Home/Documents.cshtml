	function locateCommentThread(threadId) {
		var thread = latestCommentThreads.find(function (item) {
			return item.threadId === threadId;
		});
		if (!thread) {
			setStatus("The selected comment thread is no longer available.", "error");
			return;
		}

		var editorIndex = buildEditorDomTextIndex();
		if (!editorIndex) {
			setStatus("The editor document is not ready for anchor lookup yet.", "error");
			return;
		}

		var structuredIndex = buildStructuredDocumentIndex(getEditorDocumentModel());
		var resolved = resolveThreadEditorRange(thread, editorIndex, structuredIndex);
		if (!resolved) {
			activeLocatedThreadId = "";
			renderCommentThreads(latestCommentThreads);
			setStatus("That comment anchor no longer matches the current editor text.", "error");
			return;
		}

		var range = resolved.range;
		editor1.focus();
		var editorDocument = editorIndex.document;
		var selection = editorDocument.defaultView && editorDocument.defaultView.getSelection
			? editorDocument.defaultView.getSelection()
			: null;
		if (selection) {
			selection.removeAllRanges();
			selection.addRange(range);
		}
		var targetElement = range.startContainer && range.startContainer.parentElement
			? range.startContainer.parentElement
			: editorDocument.body;
		if (targetElement && targetElement.scrollIntoView) {
			targetElement.scrollIntoView({ block: "center", behavior: "smooth" });
		}

		activateCommentThread(thread.threadId, {
			scrollSidebar: true
		});
		setStatus("Located the current editor match for this thread using " + describeAnchorMatchMode(resolved.liveAnchor.matched ? resolved.liveAnchor.mode : resolved.domAnchor.mode) + ".", "success");
	}

	function locateSuggestion(suggestionId) {
		var suggestion = latestSuggestions.find(function (item) {
			return item.suggestionId === suggestionId;
		});
		if (!suggestion) {
			setStatus("The selected suggestion is no longer available.", "error");
			return;
		}

		var editorIndex = buildEditorDomTextIndex();
		if (!editorIndex) {
			setStatus("The editor document is not ready for anchor lookup yet.", "error");
			return;
		}

		var structuredIndex = buildStructuredDocumentIndex(getEditorDocumentModel());
		var resolved = resolveThreadEditorRange(suggestion, editorIndex, structuredIndex);
		if (!resolved) {
			activeLocatedSuggestionId = "";
			renderSuggestions(latestSuggestions);
			setStatus("That suggestion anchor no longer matches the current editor text.", "error");
			return;
		}

		var range = resolved.range;
		editor1.focus();
		var editorDocument = editorIndex.document;
		var selection = editorDocument.defaultView && editorDocument.defaultView.getSelection
			? editorDocument.defaultView.getSelection()
			: null;
		if (selection) {
			selection.removeAllRanges();
			selection.addRange(range);
		}
		var targetElement = range.startContainer && range.startContainer.parentElement
			? range.startContainer.parentElement
			: editorDocument.body;
		if (targetElement && targetElement.scrollIntoView) {
			targetElement.scrollIntoView({ block: "center", behavior: "smooth" });
		}

		activateSuggestion(suggestion.suggestionId, {
			scrollSidebar: true
		});
		setStatus("Located the current editor match for this suggestion using " + describeAnchorMatchMode(resolved.liveAnchor.matched ? resolved.liveAnchor.mode : resolved.domAnchor.mode) + ".", "success");
	}

	function applySuggestionToDraft(suggestionId, options) {
		var settings = options || {};
		var announce = function (message, tone) {
			if (!settings.silent) {
				setStatus(message, tone);
			}
		};

		var suggestion = latestSuggestions.find(function (item) {
			return item.suggestionId === suggestionId;
		});
		if (!suggestion) {
			announce("The selected suggestion is no longer available.", "error");
			return false;
		}

		if (!canApplySuggestionToDraft(suggestion)) {
			announce("Accept this suggestion and add suggested text before applying it to the draft.", "error");
			return false;
		}

		var editorIndex = buildEditorDomTextIndex();
		if (!editorIndex) {
			announce("The editor document is not ready for draft updates yet.", "error");
			return false;
		}

		var structuredIndex = buildStructuredDocumentIndex(getEditorDocumentModel());
		var resolved = resolveThreadEditorRange(suggestion, editorIndex, structuredIndex);
		if (!resolved) {
			activeLocatedSuggestionId = "";
			if (!settings.silent) {
				renderSuggestions(latestSuggestions);
			}
			announce("That suggestion anchor no longer matches the current editor text.", "error");
			return false;
		}

		var focusedRange = focusResolvedEditorRange(resolved);
		if (!focusedRange || !focusedRange.document) {
			announce("The editor selection could not be restored for this suggestion.", "error");
			return false;
		}

		var targetElement = resolved.range.startContainer && resolved.range.startContainer.parentElement
			? resolved.range.startContainer.parentElement
			: focusedRange.document.body;
		if (settings.scrollIntoView !== false && targetElement && targetElement.scrollIntoView) {
			targetElement.scrollIntoView({ block: "center", behavior: "smooth" });
		}

		if (typeof editor1.notifySelectionChange === "function") {
			editor1.notifySelectionChange();
		}

		var suggestionType = String(suggestion.type || "format").toLowerCase();
		var suggestedText = String(suggestion.suggestedText || "");
		var hasSuggestedText = !!suggestedText.trim();

		try {
			if (suggestionType === "delete") {
				if (hasSuggestedText) {
					editor1.insertText(suggestedText);
				}
				else if (typeof editor1["delete"] === "function") {
					editor1["delete"]();
				}
				else {
					announce("This demo could not apply the delete suggestion because delete() is unavailable.", "error");
					return false;
				}
			}
			else if (suggestionType === "insert") {
				if (!hasSuggestedText) {
					announce("Insert suggestions need replacement text before they can be applied.", "error");
					return false;
				}

				if (typeof editor1.collapse === "function") {
					editor1.collapse(false);
				}
				else if (focusedRange.selection && focusedRange.selection.rangeCount) {
					var insertRange = focusedRange.selection.getRangeAt(0);
					insertRange.collapse(false);
					focusedRange.selection.removeAllRanges();
					focusedRange.selection.addRange(insertRange);
				}

				editor1.insertText(suggestedText);
			}
			else {
				if (!hasSuggestedText) {
					announce("Format suggestions need replacement text before they can be auto-applied in this demo.", "error");
					return false;
				}

				editor1.insertText(suggestedText);
			}
		}
		catch (error) {
			announce(error.message || "Applying the suggestion to the draft failed.", "error");
			return false;
		}

		if (typeof editor1.notifySelectionChange === "function") {
			editor1.notifySelectionChange();
		}

		hasUnsavedChanges = true;
		refreshEditorState();
		if (!settings.skipActivate) {
			activateSuggestion(suggestion.suggestionId, {
				scrollSidebar: settings.scrollSidebar !== false
			});
		}
		if (!settings.deferRefresh) {
			scheduleCommentAnchorRefresh();
			scheduleEditorHighlightRefresh();
		}
		announce("Applied the accepted suggestion to the current draft. Save to persist it.", "success");
		return true;
	}

	function applyVisibleAcceptedSuggestionsToDraft() {
		var visibleSuggestions = getVisibleSuggestions(latestSuggestions);
		var applicableSuggestions = visibleSuggestions.filter(canApplySuggestionToDraft);
		if (!applicableSuggestions.length) {
			setStatus("No accepted visible suggestions are ready to apply to the draft.", "error");
			return false;
		}

		var editorIndex = buildEditorDomTextIndex();
		if (!editorIndex) {
			setStatus("The editor document is not ready for bulk draft updates yet.", "error");
			return false;
		}

		var structuredIndex = buildStructuredDocumentIndex(getEditorDocumentModel());
		var sortedTargets = applicableSuggestions.map(function (suggestion) {
			var resolved = resolveThreadEditorRange(suggestion, editorIndex, structuredIndex);
			if (!resolved) {
				return null;
			}

			return {
				suggestion: suggestion,
				startOffset: resolved.liveAnchor && resolved.liveAnchor.matched && typeof resolved.liveAnchor.startOffset === "number"
					? resolved.liveAnchor.startOffset
					: resolved.domAnchor.startOffset
			};
		}).filter(function (item) {
			return !!item;
		}).sort(function (left, right) {
			return right.startOffset - left.startOffset;
		});

		if (!sortedTargets.length) {
			setStatus("No accepted visible suggestions still match the current draft.", "error");
			return false;
		}

		var appliedCount = 0;
		var skippedCount = applicableSuggestions.length - sortedTargets.length;
		var lastAppliedSuggestionId = "";
		sortedTargets.forEach(function (target) {
			if (applySuggestionToDraft(target.suggestion.suggestionId, {
				silent: true,
				scrollIntoView: false,
				scrollSidebar: false,
				skipActivate: true,
				deferRefresh: true
			})) {
				appliedCount += 1;
				lastAppliedSuggestionId = target.suggestion.suggestionId;
			}
			else {
				skippedCount += 1;
			}
		});

		if (!appliedCount) {
			setStatus("None of the accepted visible suggestions could be applied to the current draft.", "error");
			return false;
		}

		if (lastAppliedSuggestionId) {
			activateSuggestion(lastAppliedSuggestionId, {
				scrollSidebar: true
			});
		}

		scheduleCommentAnchorRefresh();
		scheduleEditorHighlightRefresh();
		setStatus("Applied "
			+ appliedCount
			+ " accepted visible suggestion(s) to the current draft"
			+ (skippedCount ? ". " + skippedCount + " could not be applied from the current anchors." : ".")
			+ " Save to persist the batch.", "success");
		return true;
	}

	function findAllOccurrences(haystack, needle) {
		var matches = [];
		if (!haystack || !needle) {
			return matches;
		}

		var startIndex = 0;
		while (startIndex < haystack.length) {
			var nextIndex = haystack.indexOf(needle, startIndex);
			if (nextIndex < 0) {
				break;
			}

			matches.push(nextIndex);
			startIndex = nextIndex + needle.length;
		}

		return matches;
	}

	function resolveAnchorOccurrence(plainText, anchorText, selectionContext) {
		var occurrences = findAllOccurrences(plainText, anchorText);
		if (!occurrences.length) {
			return null;
		}

		if (occurrences.length === 1) {
			return occurrences[0];
		}

		if (!selectionContext) {
			return null;
		}

		var localIndex = selectionContext.indexOf(anchorText);
		if (localIndex < 0) {
			return null;
		}

		var prefixHint = selectionContext.substring(Math.max(0, localIndex - 24), localIndex).trim();
		var suffixHint = selectionContext.substring(localIndex + anchorText.length, Math.min(selectionContext.length, localIndex + anchorText.length + 24)).trim();
		var bestScore = 0;
		var bestIndex = null;

		occurrences.forEach(function (index) {
			var score = 0;
			if (prefixHint) {
				var before = plainText.substring(Math.max(0, index - prefixHint.length), index).trim();
				if (before === prefixHint) {
					score += 2;
				}
				else if (before && (prefixHint.endsWith(before) || before.endsWith(prefixHint))) {
					score += 1;
				}
			}

			if (suffixHint) {
				var after = plainText.substring(index + anchorText.length, Math.min(plainText.length, index + anchorText.length + suffixHint.length)).trim();
				if (after === suffixHint) {
					score += 2;
				}
				else if (after && (suffixHint.startsWith(after) || after.startsWith(suffixHint))) {
					score += 1;
				}
			}

			if (score > bestScore) {
				bestScore = score;
				bestIndex = index;
			}
		});

		return bestScore > 0 ? bestIndex : null;
	}

	function buildAnchorMetadata(anchorText, selectionSnapshot) {
		var normalizedAnchorText = normalizePlainText(anchorText);
		var anchor = {
			anchorBlockEndOffset: null,
			anchorBlockPath: null,
			anchorBlockStartOffset: null,
			anchorBlockType: null,
			anchorEndTextNodeOffset: null,
			anchorEndTextNodePath: null,
			anchorStartTextNodeOffset: null,
			anchorStartTextNodePath: null,
			anchorTextNodeEndOffset: null,
			anchorTextNodePath: null,
			anchorTextNodeStartOffset: null,
			anchorText: normalizedAnchorText,
			anchorRevision: currentRevision > 0 ? currentRevision : null,
			anchorStartOffset: null,
			anchorEndOffset: null,
			anchorContextBefore: null,
			anchorContextAfter: null
		};

		var plainText = getEditorPlainText();
		if (!plainText || !normalizedAnchorText) {
			return anchor;
		}

		var snapshot = selectionSnapshot && selectionSnapshot.anchorText === normalizedAnchorText
			? selectionSnapshot
			: getEditorSelectionSnapshot();
		var startOffset = null;
		if (snapshot && snapshot.anchorText === normalizedAnchorText && snapshot.startOffset !== null && snapshot.endOffset !== null) {
			startOffset = snapshot.startOffset;
			anchor.anchorStartOffset = snapshot.startOffset;
			anchor.anchorEndOffset = snapshot.endOffset;
			anchor.anchorContextBefore = snapshot.contextBefore || null;
			anchor.anchorContextAfter = snapshot.contextAfter || null;
		}

		if (startOffset === null) {
			var selectionContext = "";
			try {
				var selection = window.getSelection ? window.getSelection() : null;
				if (selection && selection.rangeCount) {
					var container = selection.getRangeAt(0).commonAncestorContainer;
					selectionContext = container && container.textContent ? String(container.textContent) : "";
				}
			}
			catch (error) {
			}

			startOffset = resolveAnchorOccurrence(plainText, normalizedAnchorText, selectionContext);
		}
		if (startOffset === null) {
			return anchor;
		}

		if (anchor.anchorStartOffset === null) {
			anchor.anchorStartOffset = startOffset;
			anchor.anchorEndOffset = startOffset + normalizedAnchorText.length;
			anchor.anchorContextBefore = plainText.substring(Math.max(0, startOffset - 32), startOffset).trim() || null;
			anchor.anchorContextAfter = plainText.substring(anchor.anchorEndOffset, Math.min(plainText.length, anchor.anchorEndOffset + 32)).trim() || null;
		}

		var structuredIndex = buildStructuredDocumentIndex(getEditorDocumentModel());
		var startTextNode = findStructuredTextNodeAtOffset(structuredIndex, anchor.anchorStartOffset, false);
		var endTextNode = findStructuredTextNodeAtOffset(structuredIndex, anchor.anchorEndOffset - 1, true);
		if (startTextNode && endTextNode) {
			anchor.anchorStartTextNodePath = cloneAnchorPath(startTextNode.path);
			anchor.anchorStartTextNodeOffset = anchor.anchorStartOffset - startTextNode.startOffset;
			anchor.anchorEndTextNodePath = cloneAnchorPath(endTextNode.path);
			anchor.anchorEndTextNodeOffset = anchor.anchorEndOffset - endTextNode.startOffset;

			if (startTextNode.pathKey === endTextNode.pathKey) {
				anchor.anchorTextNodePath = cloneAnchorPath(startTextNode.path);
				anchor.anchorTextNodeStartOffset = anchor.anchorStartTextNodeOffset;
				anchor.anchorTextNodeEndOffset = anchor.anchorEndTextNodeOffset;
			}
		}

		var structuredBlock = findBestStructuredAnchorBlock(
			structuredIndex,
			normalizedAnchorText,
			startOffset,
			anchor.anchorContextBefore,
			anchor.anchorContextAfter,
			null);
		if (structuredBlock) {
			anchor.anchorBlockPath = cloneAnchorPath(structuredBlock.block.path);
			anchor.anchorBlockType = structuredBlock.block.type;
			anchor.anchorBlockStartOffset = structuredBlock.blockStartOffset;
			anchor.anchorBlockEndOffset = structuredBlock.blockEndOffset;
		}

		var structuredTextNode = findBestStructuredTextNode(
			structuredIndex,
			normalizedAnchorText,
			startOffset,
			anchor.anchorContextBefore,
			anchor.anchorContextAfter,
			null,
			structuredBlock && structuredBlock.block ? structuredBlock.block.pathKey : null);
		if (!structuredTextNode) {
			structuredTextNode = findBestStructuredTextNode(
				structuredIndex,
				normalizedAnchorText,
				startOffset,
				anchor.anchorContextBefore,
				anchor.anchorContextAfter,
				null,
				null);
		}

		if (structuredTextNode) {
			anchor.anchorTextNodePath = cloneAnchorPath(structuredTextNode.textNode.path);
			anchor.anchorTextNodeStartOffset = structuredTextNode.textNodeStartOffset;
			anchor.anchorTextNodeEndOffset = structuredTextNode.textNodeEndOffset;
			if (!anchor.anchorStartTextNodePath || !anchor.anchorEndTextNodePath) {
				anchor.anchorStartTextNodePath = cloneAnchorPath(structuredTextNode.textNode.path);
				anchor.anchorStartTextNodeOffset = structuredTextNode.textNodeStartOffset;
				anchor.anchorEndTextNodePath = cloneAnchorPath(structuredTextNode.textNode.path);
				anchor.anchorEndTextNodeOffset = structuredTextNode.textNodeEndOffset;
			}
			if (!anchor.anchorBlockPath) {
				anchor.anchorBlockPath = cloneAnchorPath(structuredTextNode.block.path);
				anchor.anchorBlockType = structuredTextNode.block.type;
				anchor.anchorBlockStartOffset = structuredTextNode.blockStartOffset;
				anchor.anchorBlockEndOffset = structuredTextNode.blockEndOffset;
			}
		}

		return anchor;
	}

	function getSelectedAnchorText() {
		var snapshot = getEditorSelectionSnapshot();
		if (snapshot && snapshot.anchorText) {
			return snapshot.anchorText;
		}

		try {
			if (typeof editor1.getSelectedText === "function") {
				var selected = editor1.getSelectedText();
				if (selected && String(selected).trim()) {
					return String(selected).trim();
				}
			}
		}
		catch (error) {
		}

		try {
			if (window.getSelection) {
				var fallback = window.getSelection().toString();
				if (fallback && fallback.trim()) {
					return fallback.trim();
				}
			}
		}
		catch (error) {
		}

		return "";
	}

	function captureSelectionAnchor() {
		var anchorText = getSelectedAnchorText();
		if (!anchorText) {
			setStatus("Select text inside the editor first, then capture it as a comment anchor.", "error");
			return;
		}

		currentCommentAnchor = buildAnchorMetadata(anchorText);
		setCurrentCommentSuggestionLink("");
		document.getElementById("commentAnchorInput").value = currentCommentAnchor.anchorText;
		renderCapturedAnchor(currentCommentAnchor);
		setStatus(currentCommentAnchor.anchorStartOffset !== null
			? "Captured the current selection with stronger anchor metadata."
			: "Captured the current selection. This anchor will fall back to text matching only.", "success");
	}

	function captureSuggestionSelection() {
		var anchorText = getSelectedAnchorText();
		if (!anchorText) {
			setStatus("Select text inside the editor first, then capture it as a suggestion anchor.", "error");
			return;
		}

		currentSuggestionAnchor = buildAnchorMetadata(anchorText);
		document.getElementById("suggestionAnchorInput").value = currentSuggestionAnchor.anchorText;
		renderSuggestionAnchor(currentSuggestionAnchor);
		setStatus(currentSuggestionAnchor.anchorStartOffset !== null
			? "Captured the current selection for a review suggestion."
			: "Captured the current selection for a text-only review suggestion.", "success");
	}

	function ensureSuggestionAnchorForAi() {
		var anchorText = document.getElementById("suggestionAnchorInput").value.trim();
		if (currentSuggestionAnchor && currentSuggestionAnchor.anchorText === anchorText && anchorText) {
			return currentSuggestionAnchor;
		}

		var selectedAnchorText = getSelectedAnchorText();
		if (selectedAnchorText) {
			currentSuggestionAnchor = buildAnchorMetadata(selectedAnchorText);
			document.getElementById("suggestionAnchorInput").value = currentSuggestionAnchor.anchorText;
			renderSuggestionAnchor(currentSuggestionAnchor);
			return currentSuggestionAnchor;
		}

		if (anchorText) {
			currentSuggestionAnchor = buildAnchorMetadata(anchorText);
			renderSuggestionAnchor(currentSuggestionAnchor);
			return currentSuggestionAnchor;
		}

		return null;
	}

	async function runAiSuggestion() {
		if (!currentDocumentId) {
			setStatus("Save or load a document before running AI.", "error");
			return;
		}

		var anchor = ensureSuggestionAnchorForAi();
		if (!anchor || !anchor.anchorText) {
			setStatus("Select text inside the editor first, then run AI on that selection.", "error");
			return;
		}

		document.getElementById("aiRunSummary").textContent = "Running AI on the current selection...";

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(currentDocumentId) + "/ai/suggestions", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					action: document.getElementById("aiActionInput").value,
					tone: document.getElementById("aiToneInput").value,
					instruction: document.getElementById("aiInstructionInput").value.trim(),
					anchorText: anchor.anchorText,
					anchorRevision: anchor.anchorRevision,
					anchorStartOffset: anchor.anchorStartOffset,
					anchorEndOffset: anchor.anchorEndOffset,
					anchorStartTextNodePath: anchor.anchorStartTextNodePath,
					anchorStartTextNodeOffset: anchor.anchorStartTextNodeOffset,
					anchorEndTextNodePath: anchor.anchorEndTextNodePath,
					anchorEndTextNodeOffset: anchor.anchorEndTextNodeOffset,
					anchorTextNodePath: anchor.anchorTextNodePath,
					anchorTextNodeStartOffset: anchor.anchorTextNodeStartOffset,
					anchorTextNodeEndOffset: anchor.anchorTextNodeEndOffset,
					anchorBlockPath: anchor.anchorBlockPath,
					anchorBlockType: anchor.anchorBlockType,
					anchorBlockStartOffset: anchor.anchorBlockStartOffset,
					anchorBlockEndOffset: anchor.anchorBlockEndOffset,
					anchorContextBefore: anchor.anchorContextBefore,
					anchorContextAfter: anchor.anchorContextAfter,
					clientSessionId: clientSessionId,
					clientDisplayName: getClientDisplayName(),
					document: editor1.getJSON()
				})
			});

			if (!response.ok) {
				throw new Error(await readError(response, "Unable to run AI for this selection."));
			}

			var payload = await response.json();
			document.getElementById("aiRunSummary").textContent = payload.message + " Provider: " + payload.provider + ".";
			await refreshSuggestions();
			activeLocatedSuggestionId = payload.suggestion && payload.suggestion.suggestionId
				? payload.suggestion.suggestionId
				: activeLocatedSuggestionId;
			renderSuggestions(latestSuggestions);
			scheduleEditorHighlightRefresh();
			setStatus(payload.message, "success");
		}
		catch (error) {
			document.getElementById("aiRunSummary").textContent = error.message || "Unable to run AI on the current selection.";
			setStatus(error.message || "Unable to run AI on the current selection.", "error");
		}
	}

	async function createSuggestion() {
		if (!currentDocumentId) {
			setStatus("Save or load a document before creating suggestions.", "error");
			return;
		}

		var anchorText = document.getElementById("suggestionAnchorInput").value.trim();
		var body = document.getElementById("suggestionBodyInput").value.trim();
		var suggestedText = document.getElementById("suggestedTextInput").value.trim();
		var suggestionType = document.getElementById("suggestionTypeInput").value.trim().toLowerCase();
		if (!anchorText) {
			setStatus("Capture a text selection to anchor the suggestion.", "error");
			return;
		}

		if (!body && !suggestedText) {
			setStatus("Add a reviewer note or suggested text before creating the suggestion.", "error");
			return;
		}

		var anchor = currentSuggestionAnchor && currentSuggestionAnchor.anchorText === anchorText
			? currentSuggestionAnchor
			: buildAnchorMetadata(anchorText);
		currentSuggestionAnchor = anchor;
		renderSuggestionAnchor(anchor);

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(currentDocumentId) + "/suggestions", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					type: suggestionType,
					body: body,
					suggestedText: suggestedText,
					anchorText: anchor.anchorText,
					anchorRevision: anchor.anchorRevision,
					anchorStartOffset: anchor.anchorStartOffset,
					anchorEndOffset: anchor.anchorEndOffset,
					anchorStartTextNodePath: anchor.anchorStartTextNodePath,
					anchorStartTextNodeOffset: anchor.anchorStartTextNodeOffset,
					anchorEndTextNodePath: anchor.anchorEndTextNodePath,
					anchorEndTextNodeOffset: anchor.anchorEndTextNodeOffset,
					anchorTextNodePath: anchor.anchorTextNodePath,
					anchorTextNodeStartOffset: anchor.anchorTextNodeStartOffset,
					anchorTextNodeEndOffset: anchor.anchorTextNodeEndOffset,
					anchorBlockPath: anchor.anchorBlockPath,
					anchorBlockType: anchor.anchorBlockType,
					anchorBlockStartOffset: anchor.anchorBlockStartOffset,
					anchorBlockEndOffset: anchor.anchorBlockEndOffset,
					anchorContextBefore: anchor.anchorContextBefore,
					anchorContextAfter: anchor.anchorContextAfter,
					clientSessionId: clientSessionId,
					clientDisplayName: getClientDisplayName()
				})
			});

			if (!response.ok) {
				throw new Error(await readError(response, "Unable to create the suggestion."));
			}

			clearSuggestionComposer();
			await refreshSuggestions();
			setStatus("Created a new review suggestion.", "success");
		}
		catch (error) {
			setStatus(error.message || "Unable to create the suggestion.", "error");
		}
	}

	async function createCommentThread() {
