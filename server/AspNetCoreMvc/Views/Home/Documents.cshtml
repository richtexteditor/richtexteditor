		}

		var bestCandidate = null;
		structuredIndex.textNodes.forEach(function (textNode) {
			if (preferredPathKey && textNode.pathKey !== preferredPathKey) {
				return;
			}

			if (preferredBlockPathKey && textNode.blockPathKey !== preferredBlockPathKey) {
				return;
			}

			var matches = findAllOccurrences(textNode.text, anchorText);
			matches.forEach(function (relativeStartOffset) {
