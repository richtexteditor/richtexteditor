		var markdown = String(input.value || "").replace(/\r\n/g, "\n");
		if (!markdown.trim()) {
			preview.innerHTML = "<p>Add Markdown to preview the rendered HTML.</p>";
			summary.textContent = "Use this to test Markdown import and static HTML rendering without leaving the page.";
			return null;
		}

