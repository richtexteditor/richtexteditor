		slashCommandVisibleCommands = filterSlashCommandEntries(slashCommandState.query);
		if (slashCommandState.activeIndex >= slashCommandVisibleCommands.length) {
			slashCommandState.activeIndex = Math.max(0, slashCommandVisibleCommands.length - 1);
