				pushBlock(node, path);
				return;
			}

			var content = Array.isArray(node.content) ? node.content : [];
			for (var childIndex = 0; childIndex < content.length; childIndex++) {
				visit(content[childIndex], path.concat(childIndex));
			}
		}

		visit(documentModel, []);
		return index;
	}

	function findStructuredTextNodeAtOffset(structuredIndex, offset, preferEnd) {
		if (!structuredIndex || !structuredIndex.textNodes || !structuredIndex.textNodes.length || offset === null || offset === undefined) {
			return null;
