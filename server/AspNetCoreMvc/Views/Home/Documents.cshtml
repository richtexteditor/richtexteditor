	async function submitCommentReply(threadId, body) {
		if (!currentDocumentId) {
			setStatus("Load a document before replying to comment threads.", "error");
			return false;
		}

		var normalizedBody = (body || "").trim();
		if (!normalizedBody) {
			setStatus("Enter a reply before posting it.", "error");
			return false;
		}

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(currentDocumentId) + "/comments/" + encodeURIComponent(threadId) + "/replies", {
				method: "POST",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({
					body: normalizedBody,
					clientSessionId: clientSessionId,
					clientDisplayName: getClientDisplayName()
				})
			});

			if (!response.ok) {
				throw new Error(await readError(response, "Unable to post the reply."));
			}

