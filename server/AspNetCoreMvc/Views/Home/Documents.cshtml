	async function readError(response, fallbackMessage) {
		try {
			var payload = await response.json();
			return payload.message || fallbackMessage;
		}
		catch (error) {
			return fallbackMessage;
		}
	}

	function generateSessionId() {
		if (window.crypto && window.crypto.getRandomValues) {
			var bytes = new Uint8Array(8);
			window.crypto.getRandomValues(bytes);
			return Array.prototype.map.call(bytes, function (byte) {
				return byte.toString(16).padStart(2, "0");
			}).join("");
		}

		return Math.random().toString(16).slice(2) + Date.now().toString(16);
	}

	function getClientDisplayName() {
		var value = document.getElementById("clientDisplayName").value.trim();
		return value || ("Editor " + clientSessionId.substring(0, 6));
	}

	function disconnectFromDocumentRoom() {
		if (collaborationSocket) {
			collaborationSocket.onclose = null;
			collaborationSocket.close();
			collaborationSocket = null;
		}

		renderParticipants([]);
		togglePendingRemoteUpdate(false);
		setCollaborationStatus("No active room", "");
	}

	function connectToDocumentRoom(documentId, forceReconnect) {
		if (!documentId) {
			disconnectFromDocumentRoom();
			return;
		}

		if (!forceReconnect &&
			collaborationSocket &&
			collaborationSocket.readyState === WebSocket.OPEN &&
			currentDocumentId === documentId) {
			return;
		}

		if (collaborationSocket) {
			collaborationSocket.onclose = null;
			collaborationSocket.close();
		}

		currentDocumentId = documentId;
		setCollaborationStatus("Connecting to live room " + documentId + "...", "");
		var protocol = window.location.protocol === "https:" ? "wss://" : "ws://";
		var socketUrl = protocol
			+ window.location.host
			+ "/ws/documents/"
			+ encodeURIComponent(documentId)
			+ "?sessionId=" + encodeURIComponent(clientSessionId)
			+ "&displayName=" + encodeURIComponent(getClientDisplayName());

		collaborationSocket = new WebSocket(socketUrl);
		collaborationSocket.onopen = function () {
			setCollaborationStatus("Connected to room " + documentId + ".", "success");
		};
		collaborationSocket.onerror = function () {
			setCollaborationStatus("Live room connection error.", "error");
		};
		collaborationSocket.onclose = function () {
			if (currentDocumentId) {
				setCollaborationStatus("Disconnected from live room.", "error");
			}
		};
		collaborationSocket.onmessage = function (event) {
			handleCollaborationMessage(event.data);
		};
	}

	function handleCollaborationMessage(rawMessage) {
		var message = JSON.parse(rawMessage);
		if (message.type === "presence") {
			renderParticipants(message.participants || []);
			setCollaborationStatus("Live room: " + (message.count || 0) + " editor(s) connected.", "success");
			return;
		}

		if (message.type === "documentSaved") {
			if (message.sourceSessionId === clientSessionId) {
				return;
			}

			renderDocumentMeta(message.document);
			refreshSidebar();
			if (hasUnsavedChanges) {
				pendingRemoteDocument = message.document;
				togglePendingRemoteUpdate(true);
				setStatus("Remote revision received from " + (message.savedBy || "another editor") + ". Apply it after reviewing local edits.", "error");
				return;
			}

			applyDocumentResponse(message.document);
			setStatus("Live revision received from " + (message.savedBy || "another editor") + ".", "success");
			return;
		}

		if (message.type === "commentThreadCreated" || message.type === "commentThreadUpdated") {
			if (message.sourceSessionId === clientSessionId) {
				return;
			}

			refreshComments();
			setStatus("Live comment update received from " + (message.changedBy || "another editor") + ".", "success");
			return;
		}

		if (message.type === "suggestionCreated" || message.type === "suggestionUpdated") {
			if (message.sourceSessionId === clientSessionId) {
				return;
			}

			refreshSuggestions();
			setStatus("Live suggestion update received from " + (message.changedBy || "another editor") + ".", "success");
		}
	}

	function togglePendingRemoteUpdate(show) {
		document.getElementById("applyRemoteButton").style.display = show ? "inline-flex" : "none";
	}

	function applyPendingRemoteUpdate() {
		if (!pendingRemoteDocument) {
			return;
		}

		var remoteDocument = pendingRemoteDocument;
		pendingRemoteDocument = null;
		togglePendingRemoteUpdate(false);
		applyDocumentResponse(remoteDocument);
		setStatus("Applied the pending remote revision.", "success");
	}

	function renderParticipants(participants) {
		var list = document.getElementById("participantList");
		list.innerHTML = "";
		if (!participants.length) {
			var emptyItem = document.createElement("li");
			emptyItem.textContent = "Connect to a saved document to see collaborators.";
			list.appendChild(emptyItem);
			return;
		}

		participants.forEach(function (participant) {
			var li = document.createElement("li");
			var name = document.createElement("div");
			name.textContent = participant.displayName + (participant.sessionId === clientSessionId ? " (you)" : "");

			var meta = document.createElement("div");
			meta.className = "revision-meta";
			meta.textContent = "Session " + participant.sessionId.substring(0, 8);

			li.appendChild(name);
			li.appendChild(meta);
			list.appendChild(li);
		});
	}
</script>
