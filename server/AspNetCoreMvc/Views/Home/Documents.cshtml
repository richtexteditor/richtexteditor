		return score;
	}

	function findBestStructuredAnchorBlock(structuredIndex, anchorText, globalStartOffset, contextBefore, contextAfter, preferredType) {
		if (!structuredIndex || !structuredIndex.blocks.length || !anchorText) {
			return null;
		}

