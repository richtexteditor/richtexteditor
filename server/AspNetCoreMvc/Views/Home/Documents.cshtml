			caretOffset: normalizePlainText(beforeRange.toString()).length,
			contextAfter: contextAfter ? contextAfter.slice(0, 32) : null,
			contextBefore: contextBefore ? contextBefore.slice(-32) : null,
			endOffset: resolved && resolved.matched ? resolved.endOffset : null,
			range: range,
			rect: rect
				? {
					bottom: viewportOffset.top + rect.bottom,
					height: rect.height,
					left: viewportOffset.left + rect.left,
					right: viewportOffset.left + rect.right,
					top: viewportOffset.top + rect.top,
					width: rect.width
				}
				: null,
			startOffset: resolved && resolved.matched ? resolved.startOffset : null
		};
	}

	function formatSelectionActionPreview(text) {
		var normalized = normalizePlainText(text || "");
		if (!normalized) {
			return "Capture, review, or rewrite the current selection.";
		}

		return normalized.length > 78
			? "\"" + normalized.substring(0, 75) + "...\""
			: "\"" + normalized + "\"";
