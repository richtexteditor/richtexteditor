	function removeSlashCommandToken(context) {
		if (!context || !context.tokenNode || context.tokenStartOffset === null || context.tokenEndOffset === null) {
			return false;
		}

		var editorDocument = context.editorDocument || getEditorDocument();
		if (!editorDocument) {
			return false;
		}

		var selection = editorDocument.defaultView && editorDocument.defaultView.getSelection
			? editorDocument.defaultView.getSelection()
			: null;
		if (!selection) {
			return false;
		}

		var deleteRange = editorDocument.createRange();
		deleteRange.setStart(context.tokenNode, context.tokenStartOffset);
		deleteRange.setEnd(context.tokenNode, context.tokenEndOffset);
		deleteRange.deleteContents();

		var caretRange = editorDocument.createRange();
		caretRange.setStart(context.tokenNode, Math.min(context.tokenStartOffset, String(context.tokenNode.nodeValue || "").length));
		caretRange.collapse(true);
		selection.removeAllRanges();
		selection.addRange(caretRange);
		if (typeof editor1.notifySelectionChange === "function") {
			editor1.notifySelectionChange();
		}

		return true;
	}

	function executeSlashCommand(entry) {
		if (!entry) {
			return;
		}

		var context = slashCommandState.context;
		closeSlashCommandMenu();
		if (context) {
			removeSlashCommandToken(context);
		}

		entry.action();
	}

	function refreshSlashCommandMenu() {
		var snapshot = getEditorCaretSnapshot();
		var shouldOpen = slashCommandState.manualOpen
			? !!snapshot
			: !!(snapshot && snapshot.tokenNode);
		if (!shouldOpen) {
			closeSlashCommandMenu();
			return;
		}

		var menu = getSlashCommandMenu();
		if (!menu) {
			return;
		}

		slashCommandState.isOpen = true;
		slashCommandState.context = snapshot;
		slashCommandState.query = snapshot.query || "";
		if (slashCommandState.activeIndex >= filterSlashCommandEntries(slashCommandState.query).length) {
			slashCommandState.activeIndex = 0;
		}

		hideSelectionActionBar();
		hideBlockToolsBar();
		menu.style.display = "block";
		menu.setAttribute("aria-hidden", "false");

		var width = menu.offsetWidth || 320;
		var height = menu.offsetHeight || 280;
		var rect = snapshot.rect || {
			bottom: 120,
			left: 24,
			top: 96,
			width: 0
		};
		var left = rect.left;
		left = Math.max(8, Math.min(left, window.innerWidth - width - 8));
		var top = rect.bottom + 10;
		if (top + height > window.innerHeight - 8) {
			top = Math.max(8, rect.top - height - 10);
		}

		menu.style.left = left + "px";
		menu.style.top = top + "px";
		renderSlashCommandMenu();
	}

	function openSlashCommandMenuFromToolbar() {
		editor1.focus();
		try {
			if (typeof editor1.getSelectedText === "function" && editor1.getSelectedText() && typeof editor1.collapse === "function") {
				editor1.collapse(false);
			}
			else if (typeof editor1.collapse === "function") {
				editor1.collapse(false);
			}
		}
		catch (error) {
		}

		slashCommandState.manualOpen = true;
		slashCommandState.activeIndex = 0;
		refreshSlashCommandMenu();
		if (!slashCommandState.isOpen) {
			slashCommandState.manualOpen = false;
			setStatus("Place the cursor inside the editor to open slash commands.", "error");
		}
	}

	function handleSlashCommandKeydown(event) {
		if (!slashCommandState.isOpen) {
			return;
		}

		var key = String(event.key || "").toLowerCase();
		if (key === "escape") {
			event.preventDefault();
			closeSlashCommandMenu();
			return;
		}

		if (key === "arrowdown") {
			event.preventDefault();
			if (slashCommandVisibleCommands.length) {
				slashCommandState.activeIndex = Math.min(slashCommandState.activeIndex + 1, slashCommandVisibleCommands.length - 1);
				renderSlashCommandMenu();
			}
			return;
		}

		if (key === "arrowup") {
			event.preventDefault();
			if (slashCommandVisibleCommands.length) {
				slashCommandState.activeIndex = Math.max(slashCommandState.activeIndex - 1, 0);
				renderSlashCommandMenu();
			}
			return;
		}

		if (key === "enter" || key === "tab") {
			if (!slashCommandVisibleCommands.length) {
				return;
			}

			event.preventDefault();
			executeSlashCommand(slashCommandVisibleCommands[slashCommandState.activeIndex]);
		}
	}

	function findNearestStructuredBlock(structuredIndex, offset) {
		if (!structuredIndex || !structuredIndex.blocks || !structuredIndex.blocks.length) {
			return null;
		}

		var safeOffset = offset !== null && offset !== undefined ? offset : 0;
		for (var index = 0; index < structuredIndex.blocks.length; index += 1) {
			var block = structuredIndex.blocks[index];
			if (safeOffset >= block.startOffset && safeOffset <= block.endOffset) {
				return block;
			}
		}

		var nearest = structuredIndex.blocks[0];
		var nearestDistance = Number.MAX_SAFE_INTEGER;
		structuredIndex.blocks.forEach(function (block) {
			var distance = Math.min(Math.abs(safeOffset - block.startOffset), Math.abs(safeOffset - block.endOffset));
			if (distance < nearestDistance) {
				nearestDistance = distance;
				nearest = block;
			}
		});
		return nearest;
	}

	function getCurrentBlockToolsContext() {
		var caretSnapshot = getEditorCaretSnapshot();
		if (!caretSnapshot) {
			return null;
		}

		var documentModel = getEditorDocumentModel();
		var structuredIndex = buildStructuredDocumentIndex(documentModel);
		var blockEntry = findNearestStructuredBlock(structuredIndex, caretSnapshot.caretOffset);
		if (!blockEntry || !blockEntry.path || !blockEntry.path.length) {
			return null;
		}

		var blockNode = getNodeAtPath(documentModel, blockEntry.path);
		var parentInfo = getParentContentInfo(documentModel, blockEntry.path);
		if (!blockNode || !parentInfo) {
			return null;
		}

		return {
			blockEntry: blockEntry,
			blockNode: blockNode,
			caretSnapshot: caretSnapshot,
			documentModel: documentModel,
			parentInfo: parentInfo,
			previewText: blockEntry.text || getStructuredNodeText(blockNode),
			siblingCount: parentInfo.content.length
		};
	}

	function canDeleteCurrentBlockContext(context) {
		if (!context || !context.parentInfo) {
			return false;
		}

		return context.parentInfo.content.length > 1;
	}

	function getBlockConversionLabel(context) {
		if (!context || !context.blockEntry) {
			return "Convert";
		}

		if (context.blockEntry.type === "heading") {
			return "Turn into paragraph";
		}

		if (context.blockEntry.type === "paragraph") {
			return "Turn into heading";
		}

		return "Convert";
	}

	function getBlockPreviewText(context) {
		if (!context || !context.previewText) {
			return "Move, duplicate, or reshape the current block.";
		}

		return context.previewText.length > 88
			? "\"" + context.previewText.substring(0, 85) + "...\""
			: "\"" + context.previewText + "\"";
	}

	function refreshBlockToolsBar() {
		if (commandPaletteState.isOpen || selectionActionBarState.visible || slashCommandState.isOpen) {
			hideBlockToolsBar();
			return;
		}

		var context = getCurrentBlockToolsContext();
		if (!context || !context.caretSnapshot || !context.caretSnapshot.rect) {
			hideBlockToolsBar();
			return;
		}

		var bar = getBlockToolsBar();
		var title = document.getElementById("blockToolsTitle");
		var preview = document.getElementById("blockToolsPreview");
		var moveUpButton = document.getElementById("blockMoveUpButton");
		var moveDownButton = document.getElementById("blockMoveDownButton");
		var duplicateButton = document.getElementById("blockDuplicateButton");
		var convertButton = document.getElementById("blockConvertButton");
		var deleteButton = document.getElementById("blockDeleteButton");
		if (!bar || !title || !preview || !moveUpButton || !moveDownButton || !duplicateButton || !convertButton || !deleteButton) {
			return;
		}

		blockToolsState.visible = true;
		blockToolsState.blockPath = cloneAnchorPath(context.blockEntry.path);
		blockToolsState.blockPathKey = context.blockEntry.pathKey;
		blockToolsState.blockType = context.blockEntry.type;
		blockToolsState.context = context;

		title.textContent = getBlockTypeLabel(context.blockEntry.type, context.blockNode) + " block";
		preview.textContent = getBlockPreviewText(context);
		moveUpButton.disabled = context.parentInfo.index <= 0;
		moveDownButton.disabled = context.parentInfo.index >= context.parentInfo.content.length - 1;
		duplicateButton.disabled = false;
		deleteButton.disabled = !canDeleteCurrentBlockContext(context);
		var canConvert = context.blockEntry.type === "paragraph" || context.blockEntry.type === "heading";
		convertButton.disabled = !canConvert;
		convertButton.textContent = getBlockConversionLabel(context);

		bar.style.display = "flex";
		bar.setAttribute("aria-hidden", "false");

		var width = bar.offsetWidth || 520;
		var height = bar.offsetHeight || 56;
		var rect = context.caretSnapshot.rect;
		var left = rect.left + (rect.width / 2) - (width / 2);
		left = Math.max(8, Math.min(left, window.innerWidth - width - 8));
		var top = rect.bottom + 14;
		if (top + height > window.innerHeight - 8) {
			top = Math.max(8, rect.top - height - 14);
		}

		bar.style.left = left + "px";
		bar.style.top = top + "px";
	}

	function openCurrentBlockTools() {
		editor1.focus();
		refreshBlockToolsBar();
		if (!blockToolsState.visible) {
			setStatus("Place the cursor inside a paragraph, heading, code block, or HTML block to open block tools.", "error");
		}
