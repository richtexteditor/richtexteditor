	async function refreshComments() {
		var list = document.getElementById("commentThreadList");
		list.innerHTML = "";
		latestCommentThreads = [];

		if (!currentDocumentId) {
			activeLocatedThreadId = "";
			clearEditorHighlights();
			var placeholder = document.createElement("li");
			placeholder.textContent = "Save or load a document to add comment threads.";
			list.appendChild(placeholder);
			return;
		}

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(currentDocumentId) + "/comments");
			if (!response.ok) {
				throw new Error(await readError(response, "Unable to load comment threads."));
			}

			latestCommentThreads = await response.json();
			if (activeLocatedThreadId && !latestCommentThreads.some(function (thread) { return thread.threadId === activeLocatedThreadId; })) {
				activeLocatedThreadId = "";
			}
			renderCommentThreads(latestCommentThreads);
			renderSuggestions(latestSuggestions);
		}
		catch (error) {
			setStatus(error.message || "Unable to load comment threads.", "error");
		}
	}

	async function refreshSuggestions() {
		var list = document.getElementById("suggestionList");
		list.innerHTML = "";
		latestSuggestions = [];
		renderSuggestionBulkState([]);

		if (!currentDocumentId) {
			activeLocatedSuggestionId = "";
			var placeholder = document.createElement("li");
