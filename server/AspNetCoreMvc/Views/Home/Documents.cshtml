<script>
	if (window.RichTextEditorStructuredBridge
		&& typeof window.RichTextEditorStructuredBridge.installStructuredContentBridge === "function") {
		window.RichTextEditorStructuredBridge.installStructuredContentBridge();
	}

	var editor1 = new RichTextEditor("#div_editor1");
	var clientSessionId = generateSessionId();
