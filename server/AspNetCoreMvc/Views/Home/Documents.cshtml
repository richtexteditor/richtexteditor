	function filterSlashCommandEntries(query) {
		var normalizedQuery = String(query || "").trim().toLowerCase();
		var entries = getSlashCommandEntries();
		if (!normalizedQuery) {
			return entries;
		}

		return entries.filter(function (entry) {
			var haystack = [
				entry.label,
				entry.description,
				entry.keywords
			].join(" ").toLowerCase();
			return haystack.indexOf(normalizedQuery) >= 0;
		});
	}

	function renderSlashCommandMenu() {
		var menu = getSlashCommandMenu();
