					block: textNode.block,
					blockEndOffset: textNode.blockStartOffset + relativeStartOffset + anchorText.length,
					blockStartOffset: textNode.blockStartOffset + relativeStartOffset,
					score: score,
					textNode: textNode,
					textNodeEndOffset: relativeStartOffset + anchorText.length,
					textNodeStartOffset: relativeStartOffset
				};

				if (!bestCandidate || candidate.score > bestCandidate.score) {
					bestCandidate = candidate;
				}
			});
		});

		return bestCandidate;
	}

	function findBestStructuredTextRange(structuredIndex, thread) {
		if (!structuredIndex || !structuredIndex.fullText || !thread || !thread.anchorText) {
			return null;
		}

		var matches = findAllOccurrences(structuredIndex.fullText, thread.anchorText);
		if (!matches.length) {
			return null;
		}

		var preferredStartPathKey = getAnchorPathKey(thread.anchorStartTextNodePath);
		var preferredEndPathKey = getAnchorPathKey(thread.anchorEndTextNodePath);
		var preferredSingleNodePathKey = getAnchorPathKey(thread.anchorTextNodePath);
		var preferredBlockPathKey = getAnchorPathKey(thread.anchorBlockPath);
		var bestCandidate = null;

		matches.forEach(function (startOffset) {
			var candidate = createStructuredTextRangeCandidate(structuredIndex, startOffset, startOffset + thread.anchorText.length, 0);
			if (!candidate) {
				return;
			}

			var score = 10;
			if (thread.anchorStartOffset !== null && thread.anchorStartOffset !== undefined) {
				score += Math.max(0, 40 - Math.min(Math.abs(candidate.startOffset - thread.anchorStartOffset), 40));
			}

			if (thread.anchorContextBefore) {
				var before = structuredIndex.fullText.substring(Math.max(0, candidate.startOffset - thread.anchorContextBefore.length), candidate.startOffset).trim();
				score += getAnchorContextScore(thread.anchorContextBefore, before);
			}

			if (thread.anchorContextAfter) {
				var after = structuredIndex.fullText.substring(candidate.endOffset, Math.min(structuredIndex.fullText.length, candidate.endOffset + thread.anchorContextAfter.length)).trim();
				score += getAnchorContextScore(thread.anchorContextAfter, after);
			}

			if (preferredStartPathKey && candidate.startTextNode && candidate.startTextNode.pathKey === preferredStartPathKey) {
				score += 35;
			}

			if (preferredEndPathKey && candidate.endTextNode && candidate.endTextNode.pathKey === preferredEndPathKey) {
				score += 35;
			}

			if (preferredSingleNodePathKey && candidate.textNode && candidate.textNode.pathKey === preferredSingleNodePathKey) {
				score += 30;
			}

			if (preferredBlockPathKey && candidate.startTextNode && candidate.startTextNode.blockPathKey === preferredBlockPathKey) {
				score += 10;
			}

			if (preferredBlockPathKey && candidate.endTextNode && candidate.endTextNode.blockPathKey === preferredBlockPathKey) {
				score += 10;
			}

			candidate.score = score;
			if (!bestCandidate || candidate.score > bestCandidate.score) {
				bestCandidate = candidate;
			}
		});

		return bestCandidate;
	}

	function scheduleCommentAnchorRefresh() {
		if (!latestCommentThreads.length && !latestSuggestions.length) {
			return;
		}

		if (commentAnchorRefreshTimer) {
			window.clearTimeout(commentAnchorRefreshTimer);
		}

		commentAnchorRefreshTimer = window.setTimeout(function () {
			commentAnchorRefreshTimer = 0;
			renderCommentThreads(latestCommentThreads);
			renderSuggestions(latestSuggestions);
		}, 120);
	}

	function getAnchorContextScore(expected, actual) {
		if (!expected || !actual) {
			return 0;
		}

		if (actual === expected) {
