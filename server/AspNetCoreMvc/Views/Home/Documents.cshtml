	function handleSelectionActionBarMouseDown(event, action) {
		if (event) {
			event.preventDefault();
			event.stopPropagation();
		}

		switch (action) {
			case "comment":
				stageSelectionActionCommentAnchor();
				break;
			case "suggestion":
				stageSelectionActionSuggestionAnchor({
					focusFieldId: "suggestionBodyInput"
				});
				break;
			case "ai-proofread":
				runSelectionActionAi("proofread");
				break;
			case "ai-rewrite":
				runSelectionActionAi("rewrite");
				break;
			default:
				hideSelectionActionBar();
				break;
		}
	}

	function insertMarkdownTemplateAtCursor(templateKey) {
		var template = markdownLabTemplates[templateKey];
		if (!template) {
			setStatus("Unknown Markdown template.", "error");
			return;
		}

		if (!window.RichTextEditor || typeof RichTextEditor.fromMarkdown !== "function" || typeof RichTextEditor.renderHTML !== "function" || !editor1 || typeof editor1.insertHTML !== "function") {
			setStatus("This editor build does not support Markdown template insertion.", "error");
			return;
		}

		var documentModel = RichTextEditor.fromMarkdown(template);
		editor1.focus();
		try {
			if (typeof editor1.getSelectedText === "function" && !editor1.getSelectedText() && typeof editor1.collapse === "function") {
				editor1.collapse(false);
			}
		}
		catch (error) {
		}

		editor1.insertHTML(RichTextEditor.renderHTML(documentModel));
		hasUnsavedChanges = true;
		refreshEditorState();
		scheduleCommentAnchorRefresh();
		scheduleEditorHighlightRefresh();
		scheduleRevisionCompareRefresh();
		document.getElementById("markdownLabSummary").textContent = "Inserted the " + templateKey + " Markdown starter at the current cursor.";
		setStatus("Inserted the " + templateKey + " Markdown starter.", "success");
	}

