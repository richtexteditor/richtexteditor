	function updateMarkdownLabPreview() {
		var input = document.getElementById("markdownEditorInput");
		var preview = document.getElementById("markdownLabHtmlPreview");
		var summary = document.getElementById("markdownLabSummary");
		if (!input || !preview || !summary) {
			return null;
