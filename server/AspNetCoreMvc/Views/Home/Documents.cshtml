		var safeOffset = Math.max(0, Math.min(offset, structuredIndex.fullText.length));
		for (var index = 0; index < structuredIndex.textNodes.length; index++) {
			var textNode = structuredIndex.textNodes[index];
			if (safeOffset < textNode.endOffset || (preferEnd && safeOffset === textNode.endOffset && safeOffset > textNode.startOffset)) {
				return textNode;
			}
		}

		return structuredIndex.textNodes[structuredIndex.textNodes.length - 1] || null;
	}

	function createStructuredTextRangeCandidate(structuredIndex, startOffset, endOffset, score) {
		if (!structuredIndex || !structuredIndex.fullText || startOffset === null || startOffset === undefined || endOffset === null || endOffset === undefined || endOffset <= startOffset) {
			return null;
		}

		var safeStart = Math.max(0, Math.min(startOffset, structuredIndex.fullText.length));
		var safeEnd = Math.max(safeStart, Math.min(endOffset, structuredIndex.fullText.length));
		if (safeEnd <= safeStart) {
