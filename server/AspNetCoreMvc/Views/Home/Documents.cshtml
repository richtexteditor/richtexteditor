					},
					{
						type: "listItem",
						content: [{ type: "paragraph", content: [{ type: "text", text: "GET /api/documents/{id}/suggestions" }] }]
					},
					{
						type: "listItem",
						content: [{ type: "paragraph", content: [{ type: "text", text: "WebSocket room: /ws/documents/{id}" }] }]
