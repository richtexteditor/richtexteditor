	function ensureFindListeners() {
		var editorDocument = getEditorDocument();
		if (!editorDocument || editorDocument.__findReady) {
			return;
		}

		editorDocument.__findReady = true;
		editorDocument.addEventListener("scroll", scheduleFindRefresh, true);
	}

	function escapeHtml(value) {
		return String(value || "")
			.replace(/&/g, "&amp;")
			.replace(/</g, "&lt;")
			.replace(/>/g, "&gt;")
			.replace(/\"/g, "&quot;");
	}

	function buildFindMatches(query) {
		var queryText = String(query || "").trim();
		var editorIndex = buildEditorDomTextIndex();
		var sourceText = editorIndex && typeof editorIndex.text === "string" ? editorIndex.text : "";
		if (!queryText || !editorIndex || !sourceText) {
			return {
				editorIndex: editorIndex,
				matches: [],
				query: queryText,
				sourceText: sourceText
			};
		}

		var normalizedSource = sourceText.toLowerCase();
		var normalizedQuery = queryText.toLowerCase();
		var matches = [];
		var cursor = 0;
		while (cursor <= normalizedSource.length - normalizedQuery.length) {
			var startOffset = normalizedSource.indexOf(normalizedQuery, cursor);
			if (startOffset < 0) {
				break;
			}

			var endOffset = startOffset + normalizedQuery.length;
			matches.push({
				endOffset: endOffset,
				matchText: sourceText.substring(startOffset, endOffset),
				startOffset: startOffset
			});
			cursor = endOffset;
		}

		return {
			editorIndex: editorIndex,
			matches: matches,
			query: queryText,
			sourceText: sourceText
		};
	}

	function getFindMatchSnippet(sourceText, match) {
		if (!sourceText || !match) {
			return "";
		}

		var before = normalizePlainText(sourceText.substring(Math.max(0, match.startOffset - 36), match.startOffset));
		var current = normalizePlainText(match.matchText);
		var after = normalizePlainText(sourceText.substring(match.endOffset, Math.min(sourceText.length, match.endOffset + 36)));
		return (before ? "..." + escapeHtml(before) + " " : "")
			+ "<mark>" + escapeHtml(current) + "</mark>"
			+ (after ? " " + escapeHtml(after) + "..." : "");
	}

	function renderFindHighlights(editorIndex) {
		var layer = getFindHighlightLayer();
		if (!layer) {
			return;
		}

		layer.innerHTML = "";
		if (!editorIndex || !findState.query || !findState.matches.length) {
			return;
		}

		var viewportOffset = getEditorViewportOffset(editorIndex.document);
		findState.matches.forEach(function (match, index) {
			var range = createEditorRangeFromOffsets(editorIndex, match.startOffset, match.endOffset);
			if (!range) {
				return;
			}

			var rects = Array.prototype.filter.call(range.getClientRects(), function (rect) {
				return rect && rect.width >= 2 && rect.height >= 2;
			});

			rects.forEach(function (rect) {
				var highlight = document.createElement("div");
				highlight.className = "find-highlight-rect" + (index === findState.activeIndex ? " active" : "");
				highlight.style.left = (viewportOffset.left + rect.left) + "px";
				highlight.style.top = (viewportOffset.top + rect.top) + "px";
				highlight.style.width = rect.width + "px";
				highlight.style.height = rect.height + "px";
				layer.appendChild(highlight);
			});
		});
	}

	function renderFindResults(preserveActiveIndex) {
		var input = document.getElementById("findQueryInput");
		var replaceInput = document.getElementById("findReplaceInput");
		var summary = document.getElementById("findSummary");
		var list = document.getElementById("findMatchList");
		var previousButton = document.getElementById("findPreviousButton");
		var nextButton = document.getElementById("findNextButton");
		var replaceCurrentButton = document.getElementById("findReplaceCurrentButton");
		var replaceAllButton = document.getElementById("findReplaceAllButton");
		if (!input || !replaceInput || !summary || !list || !previousButton || !nextButton || !replaceCurrentButton || !replaceAllButton) {
			return;
		}

		var result = buildFindMatches(input.value);
		findState.query = result.query;
		findState.matches = result.matches;

		if (!result.query) {
			findState.activeIndex = -1;
			summary.textContent = "Use Ctrl+F or type a phrase here to search across the current draft.";
			list.innerHTML = "";
			previousButton.disabled = true;
			nextButton.disabled = true;
			replaceCurrentButton.disabled = true;
			replaceAllButton.disabled = true;
			clearFindHighlights();
			return;
		}

		if (!result.matches.length) {
			findState.activeIndex = -1;
			summary.textContent = "No matches found for \"" + result.query + "\" in the current draft.";
			list.innerHTML = "";
			previousButton.disabled = true;
			nextButton.disabled = true;
			replaceCurrentButton.disabled = true;
			replaceAllButton.disabled = true;
			clearFindHighlights();
			return;
		}

		if (!preserveActiveIndex || findState.activeIndex < 0 || findState.activeIndex >= result.matches.length) {
			findState.activeIndex = 0;
		}

		summary.textContent = result.matches.length
			+ " match"
			+ (result.matches.length === 1 ? "" : "es")
			+ " for \"" + result.query + "\". Match "
			+ (findState.activeIndex + 1)
			+ " of "
			+ result.matches.length
			+ ".";

		list.innerHTML = "";
		result.matches.slice(0, 12).forEach(function (match, index) {
			var item = document.createElement("li");
			item.className = "find-match" + (index === findState.activeIndex ? " active" : "");

			var snippet = document.createElement("div");
			snippet.className = "find-match-snippet";
			snippet.innerHTML = getFindMatchSnippet(result.sourceText, match);

			var meta = document.createElement("span");
			meta.className = "find-match-meta";
			meta.textContent = "Match " + (index + 1) + " of " + result.matches.length;

			var jumpButton = document.createElement("button");
			jumpButton.type = "button";
			jumpButton.className = "outline-item-button";
			jumpButton.textContent = "Jump";
			jumpButton.onclick = function () {
				locateFindMatch(index);
			};

			var header = document.createElement("div");
			header.className = "outline-item-header";
			header.appendChild(jumpButton);

			item.appendChild(header);
			item.appendChild(snippet);
			item.appendChild(meta);
			list.appendChild(item);
		});

		previousButton.disabled = result.matches.length < 2;
		nextButton.disabled = result.matches.length < 2;
		replaceCurrentButton.disabled = findState.activeIndex < 0;
		replaceAllButton.disabled = !result.matches.length || normalizePlainText(replaceInput.value) === normalizePlainText(result.query);
		renderFindHighlights(result.editorIndex);
	}

	function handleFindQueryInput() {
		renderFindResults(false);
	}

	function clearFindQuery() {
		var input = document.getElementById("findQueryInput");
