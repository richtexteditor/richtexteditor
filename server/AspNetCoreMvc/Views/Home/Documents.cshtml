	async function postSuggestionStatusChange(suggestionId, status) {
		if (!currentDocumentId) {
			throw new Error("Load a document before updating suggestions.");
		}

		var action = status === "accepted" ? "accept" : "reject";
		var response = await fetch("/api/documents/" + encodeURIComponent(currentDocumentId) + "/suggestions/" + encodeURIComponent(suggestionId) + "/" + action, {
			method: "POST",
			headers: { "Content-Type": "application/json" },
			body: JSON.stringify({
				clientSessionId: clientSessionId,
				clientDisplayName: getClientDisplayName()
			})
		});

		if (!response.ok) {
			throw new Error(await readError(response, "Unable to update the suggestion status."));
		}
	}

	async function setSuggestionStatus(suggestionId, status) {
		try {
			await postSuggestionStatusChange(suggestionId, status);
			await refreshSuggestions();
			setStatus(status === "accepted" ? "Accepted the suggestion." : "Rejected the suggestion.", "success");
		}
		catch (error) {
			setStatus(error.message || "Unable to update the suggestion status.", "error");
		}
	}

	async function setVisibleSuggestionStatus(status) {
		if (!currentDocumentId) {
			setStatus("Load a document before updating suggestions.", "error");
			return;
		}

		var visibleSuggestions = getVisibleSuggestions(latestSuggestions);
		var targets = visibleSuggestions.filter(function (suggestion) {
			return suggestion.status !== status;
		});
		if (!targets.length) {
			setStatus(status === "accepted"
				? "No visible suggestions need to be accepted."
				: "No visible suggestions need to be rejected.", "error");
			return;
		}

		var updatedCount = 0;
		try {
			for (var index = 0; index < targets.length; index += 1) {
				await postSuggestionStatusChange(targets[index].suggestionId, status);
				updatedCount += 1;
			}

			await refreshSuggestions();
			setStatus((status === "accepted" ? "Accepted " : "Rejected ")
				+ updatedCount
				+ " visible suggestion(s).", "success");
		}
		catch (error) {
			await refreshSuggestions();
			setStatus(error.message || "Unable to update the visible suggestion set.", "error");
		}
	}

	async function refreshSidebar() {
		await Promise.all([refreshDocuments(), refreshRevisions(), refreshComments(), refreshSuggestions()]);
	}

	async function refreshDocuments() {
		try {
			var response = await fetch("/api/documents");
			if (!response.ok) {
				throw new Error(await readError(response, "Unable to load documents."));
			}

			var documents = await response.json();
			var list = document.getElementById("documentList");
			list.innerHTML = "";

			if (!documents.length) {
				var emptyItem = document.createElement("li");
				emptyItem.textContent = "No saved documents yet.";
				list.appendChild(emptyItem);
				return;
			}

			documents.forEach(function (item) {
				var li = document.createElement("li");
				var button = document.createElement("button");
				button.type = "button";
				button.className = "doc-link";
				button.textContent = item.title + " (" + item.id + ")";
				button.onclick = function () {
					loadDocument(item.id);
				};

				var meta = document.createElement("div");
				meta.className = "revision-meta";
				meta.textContent = "Revision " + item.revision + " - updated " + new Date(item.updatedUtc).toLocaleString();

				li.appendChild(button);
				li.appendChild(meta);
				list.appendChild(li);
			});
		}
		catch (error) {
			setStatus(error.message || "Unable to refresh documents.", "error");
		}
	}

	async function refreshRevisions() {
		var documentId = document.getElementById("documentId").value.trim();
		var list = document.getElementById("revisionList");
		list.innerHTML = "";
		latestRevisionSummaries = [];
		var compareButton = document.getElementById("compareLatestRevisionButton");
		if (compareButton) {
			compareButton.disabled = true;
		}

		if (!documentId) {
			clearRevisionCompare();
			var placeholder = document.createElement("li");
			placeholder.textContent = "Load a document to view revisions.";
			list.appendChild(placeholder);
			return;
		}

		try {
			var response = await fetch("/api/documents/" + encodeURIComponent(documentId) + "/revisions");
			if (!response.ok) {
				throw new Error(await readError(response, "Unable to load revisions."));
			}

			var revisions = await response.json();
			latestRevisionSummaries = revisions;
			if (!revisions.length) {
				clearRevisionCompare();
				var emptyItem = document.createElement("li");
				emptyItem.textContent = "No revisions yet.";
				list.appendChild(emptyItem);
				return;
			}

			renderRevisions(revisions);
		}
		catch (error) {
			latestRevisionSummaries = [];
			clearRevisionCompare();
			setStatus(error.message || "Unable to load revisions.", "error");
		}
	}

